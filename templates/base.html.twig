
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Studio Lapimprenelle{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body class="bg-cream text-ink font-sans">
    
   
<header class="flex items-center justify-between px-10 py-5 mx-auto">
    <div class="flex items-center gap-2">
      <a href="{{ path('app_home') }}" class="flex items-center">
      <img src="{{ asset('images/logo_tempo.png') }}" alt="logo tempo" class="w-[220px] h-auto"> </a>
    </div>
    <nav class="hidden md:flex items-center gap-8 text-sm text-ink-soft">
      <a href="{{ path('app_home') }}" class="text-terracotta border-b border-terracotta pb-1">Accueil</a>
      <a href="{{ path('app_service') }}" class="hover:text-ink">Services</a>
      <a href="{{ path('app_projet_index') }}" class="hover:text-ink">Réalisations</a>
      <a href="{{ path('app_apropos') }}" class="hover:text-ink">À propos</a>
      <a href="{{ path('app_article_index') }}" class="hover:text-ink">Blog</a>
    </nav>
    <a href="{{ path('app_contact') }}" class="bg-terracotta hover:bg-terracotta-dark text-cream text-sm px-5 py-2.5 rounded-full inline-flex items-center gap-1.5">
      Contact <span aria-hidden="true">→</span>
    </a>
  </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="px-6 py-4 border-t border-gray-200 flex justify-between text-xs text-gray-400">
        <span>Tempo agence web Toulouse</span>
        <span>contact@lapimprenelle.fr</span>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>