{% extends 'base.html.twig' %}
{% block title %} Blog WordPress, Symfony & SEO — Tempo   {% endblock %}


{% block meta_description %}
    Découvrez le blog Tempo : conseils en création de sites web, WordPress, Symfony, SEO et stratégie digitale pour développer votre présence en ligne.
{% endblock %}


{% block body %}
<div class="bg-cream text-ink">

  {# INTRO #}
  <section class="max-w-4xl mx-auto px-6 sm:px-8 pt-16 lg:pt-24 pb-12 text-center">
    <div class="inline-flex items-center gap-3 mb-6">
     <h1 class="font-display text-5xl sm:text-5xl leading-tight mb-6">
      Référencement naturel &amp; développement web
    </h1>
    </div>

   

  </section>

  {# GRILLE D'ARTICLES #}
  <section class="max-w-6xl mx-auto px-6 sm:px-8 pb-24">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for article in articles %}
      <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="group block">
        <div class="h-64 rounded-2xl overflow-hidden bg-[#D9C8A9] mb-4 flex items-center justify-center">
      {% if article.image %}
        <img src="{{ asset('images/' ~ article.image) }}" alt="{{ article.titre }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
      {% endif %}
      </div>
        <div class="text-xs tracking-widest text-terracotta font-medium mb-2">
          {{ article.publishedAt|date('d M') }}
        </div>
        <h2 class="font-display text-lg leading-snug mb-2 group-hover:text-terracotta transition-colors">
          {{ article.titre }}
        </h2>
        {% if article.extrait %}
        <p class="text-sm text-ink-soft leading-relaxed line-clamp-2">
          {{ article.extrait }}
        </p>
        {% endif %}
      </a>
      {% else %}
      <p class="text-sm text-ink-soft col-span-full text-center">Aucun article publié pour le moment.</p>
      {% endfor %}
    </div>
  </section>

</div>
{% endblock %}