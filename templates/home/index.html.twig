{# =========================================================
   JAVASCRIPT — NAVIGATION TACTILE DE L'ÉVENTAIL
========================================================= #}

<script>
(function () {

    function initTempoFan() {

        const fan = document.getElementById('tempo-fan');

        if (!fan || fan.dataset.initialized === 'true') {
            return;
        }

        fan.dataset.initialized = 'true';

        const cards = Array.from(fan.querySelectorAll('.tempo-fan-card'));
        const dots = Array.from(document.querySelectorAll('#tempo-fan-dots .tempo-fan-dot'));
        const prev = document.getElementById('tempo-fan-prev');
        const next = document.getElementById('tempo-fan-next');

        if (cards.length === 0) return;

        let activeIndex = Math.min(1, cards.length - 1);

        let startX = 0;
        let startY = 0;
        let tracking = false;
        let suppressClick = false;

        function updateFan() {

            cards.forEach((card, index) => {

                const offset = (index - activeIndex + cards.length) % cards.length;

                let position = 'center';

                if (offset === 1) {
                    position = 'right';
                } else if (offset !== 0) {
                    position = 'left';
                }

                card.dataset.position = position;

            });

            dots.forEach((dot, index) => {

                const active = index === activeIndex;

                dot.style.backgroundColor = active
                    ? '#00687A'
                    : 'rgba(0,104,122,.25)';

                dot.style.transform = active
                    ? 'scale(1.3)'
                    : 'scale(1)';

                dot.setAttribute('aria-current', active ? 'true' : 'false');

            });

        }

        function move(direction) {

            activeIndex = (activeIndex + direction + cards.length) % cards.length;

            updateFan();

        }

        if (prev) {
            prev.addEventListener('click', function () {
                move(-1);
            });
        }

        if (next) {
            next.addEventListener('click', function () {
                move(1);
            });
        }

        dots.forEach((dot, index) => {

            dot.addEventListener('click', function () {

                activeIndex = index;

                updateFan();

            });

        });

        // Début du geste tactile
        fan.addEventListener('touchstart', function (event) {

            if (event.touches.length !== 1) return;

            startX = event.touches[0].clientX;
            startY = event.touches[0].clientY;

            tracking = true;

        }, { passive: true });

        // Fin du geste tactile
        fan.addEventListener('touchend', function (event) {

            if (!tracking || !event.changedTouches.length) return;

            tracking = false;

            const deltaX = event.changedTouches[0].clientX - startX;
            const deltaY = event.changedTouches[0].clientY - startY;

            // Ignore les gestes trop courts et le défilement vertical
            if (
                Math.abs(deltaX) < 45 ||
                Math.abs(deltaX) <= Math.abs(deltaY)
            ) {
                return;
            }

            suppressClick = true;

            move(deltaX < 0 ? 1 : -1);

        }, { passive: true });

        fan.addEventListener('touchcancel', function () {
            tracking = false;
        }, { passive: true });

        // Empêche l'ouverture d'un projet après un swipe
        fan.addEventListener('click', function (event) {

            if (!suppressClick) return;

            event.preventDefault();
            event.stopPropagation();

            suppressClick = false;

        }, true);

        // Toucher une carte latérale la place au centre
        cards.forEach((card, index) => {

            card.addEventListener('click', function (event) {

                if (index === activeIndex) return;

                event.preventDefault();

                activeIndex = index;

                updateFan();

            });

        });

        updateFan();

    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTempoFan);
    } else {
        initTempoFan();
    }

})();
</script>


