                <div class="w-14 h-14 rounded-[1rem]
                            rotate-12 bg-[#00687A]"></div>

            </div>

        </div>


        <div class="reveal">

            {% set factors = [
                ['01', 'Nombre de pages'],
                ['02', 'Fonctionnalités spécifiques'],
                ['03', 'Contenus à intégrer'],
                ['04', 'Rédaction & optimisation SEO'],
                ['05', 'Identité visuelle'],
                ['06', 'Fonctionnalités e-commerce'],
                ['07', 'Développement sur mesure']
            ] %}

            {% for item in factors %}

                <div class="group flex items-center
                            justify-between gap-5
                            border-b border-[#D9C8A9]
                            py-4">

                    <div class="flex items-center gap-5">

                        <span class="text-xs text-[#C96A3E]">
                            {{ item[0] }}
                        </span>

                        <span class="text-sm sm:text-base
                                     text-ink
                                     group-hover:text-[#00687A]
                                     transition">
                            {{ item[1] }}
                        </span>

                    </div>

                    <span class="w-8 h-8 rounded-full
                                 border border-[#C96A3E]/40
                                 flex items-center justify-center
                                 text-[#C96A3E]
                                 transition
                                 group-hover:bg-[#C96A3E]
                                 group-hover:text-white">
                        +
                    </span>

                </div>

            {% endfor %}

        </div>

    </div>
</section>


