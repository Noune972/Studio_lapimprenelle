{% extends 'base.html.twig' %}

{% block title %}Tarifs création de site internet à Toulouse | Studio Tempo{% endblock %}

{% block meta_description %}
Découvrez les tarifs Studio Tempo pour la création de sites WordPress, sites vitrines, e-commerce, refontes et applications web sur mesure.
{% endblock %}

{% block body %}
<div class="bg-[#F7F3EC] text-ink overflow-hidden">

    {# =========================================================
       HERO — SOBRE / ÉDITORIAL
    ========================================================= #}
    <section class="relative max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pt-16 lg:pt-24 pb-14 lg:pb-16">

        {# Quelques formes Tempo uniquement dans le coin supérieur droit #}
        <div class="pointer-events-none absolute right-0 top-0 hidden lg:block w-[390px] h-[230px]" aria-hidden="true">
            <div class="absolute -right-16 -top-24 w-64 h-64 rounded-full bg-[#00687A]"></div>
            <div class="absolute right-28 -top-20 w-56 h-56 rounded-full bg-[#E9DFD1]"></div>
            <div class="absolute right-8 top-8 w-48 h-24 rounded-[50%] border border-[#C9653B]/70 rotate-[-18deg]"></div>
            <span class="absolute right-24 top-[72px] w-3 h-3 rounded-full bg-[#C9653B]"></span>
        </div>

        <div class="relative z-10 grid lg:grid-cols-[1.15fr_.85fr] gap-12 items-end">
            <div>
                <div class="flex items-center gap-4 mb-6">
                    <span class="w-9 h-[2px] bg-[#C9653B]"></span>
                    <span class="text-[11px] uppercase tracking-[0.24em] text-[#C9653B] font-semibold">
                        Tarifs
                    </span>
                </div>

                <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.8rem] leading-[1.02] tracking-[-0.035em] max-w-3xl">
                    Des solutions adaptées
                    <span class="block">à chaque <span class="text-[#C9653B]">projet.</span></span>
                </h1>

                <p class="mt-6 max-w-2xl text-base sm:text-lg leading-8 text-ink-soft">
                    Des sites web et des applications sur mesure pour développer
                    votre activité en ligne, en toute sérénité.
                </p>
            </div>

            <div class="hidden lg:flex justify-end pb-3 pr-16">
                <p class="font-display italic text-2xl leading-snug text-[#00687A] rotate-[-6deg]">
                    Le web<br>à votre rythme.
                </p>
            </div>
        </div>
    </section>


    {# =========================================================
       5 OFFRES — PALETTE UNIFIÉE
    ========================================================= #}
    <section id="offres" class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8 pb-10">

        {% set offers = [
            {
                number: '01',
                type: 'One Page',
                priceLabel: 'À partir de',
                price: '800 €',
                text: "Une présence claire et efficace pour présenter votre activité.",
                items: ['Jusqu à 5 sections de contenus','Présentation de votre activité','Liens vers vos réseaux sociaux','Avis Google','Boutons d appels à l action','Design personnalisé et responsive','Formulaire de contact','Optimisation SEO de base','Formation à la prise en main']
            },
            {
                number: '02',
                type: 'Site vitrine',
                priceLabel: 'À partir de',
                price: '1 400 €',
                text: "Un site complet pour développer votre image et votre visibilité.",
                items: ["Jusqu'à 5 pages",'Design personnalisé et responsive','Présentation de votre activité et de vos services','Formulaire de contact','Structure en navigation sur mesure', 'Rédaction complète des pages optimisée SEO','Optimisation SEO','Formation à la prise en main']
            },
            {
                number: '03',
                type: 'Site e-commerce',
                priceLabel: 'À partir de',
                price: '2 000 €',
                text: "Une boutique en ligne performante pour vendre vos produits ou services.",
                items: ["Jusqu'à 20 produits intégrés",'WooCommerce','Gestion des paiements et stocks', 'Paniers et tunnels de commandes','Paiement sécurisé','Configuration des modes de livraisons','Optimisation SEO','Formation à la gestion des produits et commandes']
            },
            {
                number: '04',
                type: 'Refonte de site',
                priceLabel: '',
                price: 'Sur devis',
                text: "Une refonte pour un site plus performant, plus moderne et mieux aligné avec vos objectifs.",
                items: ["Audit de votre site existant",'Recommandations','Refonte graphique et design personnalisé', 'Amélioration de l expérience utilisateur','Optimisation techniqueSEO','Formation à la prise en main']
            },
            {
                number: '05',
                type: 'Application web & mobile',
                priceLabel: '',
                price: 'Sur mesure',
                text: "Une solution sur mesure pour des besoins spécifiques et évolutifs.",
                items: ['Analyse de vos besoins','Développement Symfony sur mesure', 'Fonctionnalités metier','Espaces utilisateurs sécurisés','Interface personnalisée','Connexions API et services externes','Maintenance et évolution','Accompagnement à la prise en main']
            }
        ] %}

        <div class="grid md:grid-cols-2 xl:grid-cols-5 gap-3 lg:gap-4 items-stretch">
            {% for offer in offers %}
<article class="group bg-[#FBF8F3]
                border-2 border-terracotta/60
                rounded-[1.15rem]
                px-4 py-5 sm:px-5 sm:py-6 lg:px-6 lg:py-7
                min-h-0 sm:min-h-[550px] flex flex-col
                transition duration-300 hover:-translate-y-1
                hover:shadow-[0_16px_45px_rgba(32,51,55,0.06)]">

                    <div class="h-full flex flex-col">
                        <div class="flex items-center gap-3">
                            <span class="text-[11px] font-semibold tracking-[0.12em] text-[#C9653B]">
                                {{ offer.number }}
                            </span>
                            {# Pictogramme de l'offre #}
<div class="mt-5 mb-5 flex items-center justify-center
            w-16 h-16
            rounded-[45%_55%_52%_48%/55%_45%_55%_45%]
            {% if loop.index is odd %}
            bg-[#00687A]/10
            {% else %}
            bg-[#C9653B]/10
            {% endif %}
            text-[#00687A]
            transition-transform duration-300
            group-hover:rotate-[-4deg]
            group-hover:scale-105">

    {% if offer.number == '01' %}
        {# ONE PAGE #}
        <svg viewBox="0 0 24 24"
             class="w-8 h-8"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <rect x="4" y="3" width="16" height="18" rx="2"/>
            <path d="M7 7h10"/>
            <path d="M7 11h7"/>
            <path d="M7 15h10"/>
            <path d="M7 18h6"/>
        </svg>

    {% elseif offer.number == '02' %}
        {# SITE VITRINE #}
        <svg viewBox="0 0 24 24"
             class="w-8 h-8"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="14" rx="2"/>
            <path d="M3 8h18"/>
            <circle cx="6" cy="6" r=".5" fill="currentColor"/>
            <circle cx="8" cy="6" r=".5" fill="currentColor"/>
            <path d="M8 21h8"/>
            <path d="M12 18v3"/>
        </svg>

    {% elseif offer.number == '03' %}
        {# E-COMMERCE #}
        <svg viewBox="0 0 24 24"
             class="w-8 h-8"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20 8H7"/>
            <circle cx="10" cy="20" r="1"/>
            <circle cx="17" cy="20" r="1"/>
            <path d="M10 11h6"/>
            <path d="M13 8v6"/>
        </svg>

    {% elseif offer.number == '04' %}
        {# REFONTE #}
        <svg viewBox="0 0 24 24"
             class="w-8 h-8"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <path d="M20 7v5h-5"/>
            <path d="M4 17v-5h5"/>
            <path d="M6.1 8A7 7 0 0 1 18.5 6L20 8"/>
            <path d="M17.9 16A7 7 0 0 1 5.5 18L4 16"/>
        </svg>

    {% elseif offer.number == '05' %}
        {# APPLICATION WEB & MOBILE #}
        <svg viewBox="0 0 24 24"
             class="w-8 h-8"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <path d="M8 9l-4 3 4 3"/>
            <path d="M16 9l4 3-4 3"/>
            <path d="M14 6l-4 12"/>
        </svg>
    {% endif %}

</div>
                            <span class="w-8 h-px bg-[#C9653B]/60"></span>
                        </div>

                        <h2 class="font-display text-xl text-[#00687A] mt-7">
                            {{ offer.type }}
                        </h2>

                        <div class="mt-5 min-h-[66px]">
                            {% if offer.priceLabel %}
                                <p class="text-[10px] uppercase tracking-[0.16em] text-ink-soft/70 mb-1.5">
                                    {{ offer.priceLabel }}
                                </p>
                            {% endif %}
                            <p class="font-display text-[2.25rem] leading-none text-[#00687A]">
                                {{ offer.price }}
                            </p>
                        </div>

                        <p class="mt-5 text-sm leading-6 text-ink-soft min-h-[96px]">
                            {{ offer.text }}
                        </p>

                        <div class="my-5 h-px bg-[#DED5C9]"></div>

                        <div class="space-y-2.5">
                            {% for item in offer.items %}
                                <div class="flex items-start gap-2.5 text-[12px] leading-5">
                                    <span class="text-[#C9653B] mt-[1px]">✓</span>
                                    <span>{{ item }}</span>
                                </div>
                            {% endfor %}
                            <div class="mt-auto pt-7">
    <a href="{{ path('app_contact') }}"
       class="inline-flex items-center justify-center gap-3
              w-full rounded-full
              bg-[#00687A] text-white
              px-5 py-3
              text-sm font-semibold
              transition-all duration-300
              hover:bg-[#005966]
              hover:-translate-y-0.5">
        Demander un devis
        <span aria-hidden="true">→</span>
    </a>
</div>
                        </div>

                        <div class="mt-auto pt-7">
                            <div class="pt-4 border-t border-[#DED5C9] text-[11px] leading-4 text-ink-soft">
                                Paiement échelonné<br>sans frais possible.
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>


    {# =========================================================
       OFFRE DE LANCEMENT
    ========================================================= #}
    <section class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="relative overflow-hidden rounded-[1.4rem] bg-[#00687A] text-white">

            <div class="absolute -right-20 -top-24 w-64 h-64 rounded-full border border-white/15" aria-hidden="true"></div>

            <div class="relative z-10 grid lg:grid-cols-[.8fr_1.25fr_.85fr] items-center gap-8 lg:gap-10 px-6 sm:px-9 lg:px-12 py-9">

                <div>
                    <p class="text-[10px] uppercase tracking-[0.24em] text-white/75 font-semibold mb-4">
                        Offre de lancement
                    </p>

                    <div class="inline-flex items-center justify-center
                                min-w-[205px] px-8 py-5
                                bg-[#C9653B]
                                rounded-[48%_52%_50%_50%/56%_46%_54%_44%]
                                rotate-[-2deg]">
                        <strong class="font-display text-5xl sm:text-6xl leading-none text-white rotate-[2deg]">
                            −10 %
                        </strong>
                    </div>
                </div>

                <div class="lg:border-l lg:border-white/25 lg:pl-10">
                    <h2 class="font-display text-2xl sm:text-3xl leading-tight">
                        sur toutes les créations
                        <span class="block">de sites web et applis.</span>
                    </h2>

                    <p class="mt-4 text-sm leading-6 text-white/70">
                        Une opportunité pour donner vie à votre projet dès maintenant.
                    </p>
                </div>

                <div class="lg:border-l lg:border-white/25 lg:pl-10">
                    <p class="text-sm leading-6 text-white/80">
                        Offre valable jusqu'au
                        <strong class="text-white">31 octobre 2026</strong>.
                    </p>

                    <a href="{{ path('app_contact') }}"
                       class="mt-5 inline-flex items-center justify-between gap-6
                              rounded-full bg-[#F7F3EC] text-[#00687A]
                              px-6 py-3.5 text-sm font-semibold
                              transition hover:bg-white">
                        Demander un devis
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>


    {# =========================================================
       DEVIS SUR MESURE
    ========================================================= #}
    <section class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-14 lg:py-20">

        <div class="reveal">
            <div class="flex items-center gap-4 mb-4">
                <span class="w-9 h-[2px] bg-[#C9653B]"></span>
                <span class="text-xs uppercase tracking-[0.2em] text-[#C9653B] font-semibold">
                    Qu'est-ce qui fait évoluer le devis ?
                </span>
            </div>

            <h2 class="font-display text-3xl sm:text-4xl leading-[1.1]">
                Un tarif qui
                <span class="text-[#C9653B]">s'adapte à vos besoins.</span>
            </h2>

            <p class="mt-4 text-ink-soft">
                Chaque projet est unique. Le devis final dépend de plusieurs éléments.
            </p>
        </div>

        {% set factors = [
            ['01','Nombre de pages','Plus de contenu à créer et à intégrer'],
            ['02','Fonctionnalités spécifiques','Formulaires, espace client, réservations…'],
            ['03','Création de contenus','Rédaction, intégration et optimisation'],
            ['04','Optimisation SEO','Structure, performance et contenus optimisés'],
            ['05','Identité visuelle','Charte graphique et éléments sur mesure'],
            ['06','Sur mesure','Besoins spécifiques et fonctionnalités avancées']
        ] %}

        <div class="grid sm:grid-cols-2 lg:grid-cols-7 gap-x-6 gap-y-9 mt-12">
            {% for item in factors %}
                <div class="reveal relative">

                    <div class="flex items-center gap-3 mb-4">
                        <span class="text-xs font-semibold text-[#C9653B]">{{ item[0] }}</span>
                        <span class="h-px flex-1 {% if loop.index is even %}bg-[#00687A]/50{% else %}bg-[#C9653B]/50{% endif %}"></span>
                    </div>

                    <h3 class="text-sm leading-5 font-semibold text-[#00687A]">
                        {{ item[1] }}
                    </h3>

                    <p class="mt-2 text-xs leading-5 text-ink-soft">
                        {{ item[2] }}
                    </p>
                </div>
            {% endfor %}
        </div>
    </section>

        {# =========================================================
       FAQ
    ========================================================= #}
    <section class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-14 lg:py-20">

        <div class="grid lg:grid-cols-[.75fr_1.25fr] gap-10 lg:gap-16 items-start">

            {# Introduction #}
            <div class="reveal lg:sticky lg:top-28">

                <div class="flex items-center gap-4 mb-4">
                    <span class="w-9 h-[2px] bg-[#C9653B]"></span>

                    <span class="text-xs uppercase tracking-[0.2em]
                                 text-[#C9653B] font-semibold">
                        Questions fréquentes
                    </span>
                </div>

                <h2 class="font-display text-3xl sm:text-4xl leading-[1.1] text-[#00687A]">
                    Une question avant
                    <span class="block text-[#C9653B]">
                        de vous lancer ?
                    </span>
                </h2>

                <p class="mt-5 text-ink-soft leading-7 max-w-md">
                    Délais, accompagnement, maintenance…
                    voici les réponses aux questions que vous pouvez
                    vous poser avant de démarrer votre projet.
                </p>

                {# Petit élément graphique #}
                <div class="hidden lg:block mt-10 relative w-40 h-28"
                     aria-hidden="true">

                    <div class="absolute left-0 top-2
                                w-24 h-24 rounded-full
                                bg-[#00687A]/10">
                    </div>

                    <div class="absolute left-16 top-10
                                w-20 h-12
                                rounded-[50%]
                                border border-[#C9653B]/60
                                rotate-[-12deg]">
                    </div>

                    <span class="absolute left-24 top-5
                                 w-3 h-3 rounded-full
                                 bg-[#C9653B]">
                    </span>

                </div>
            </div>


            {# Questions #}
            <div class="space-y-3">

                {% set faqs = [
                    {
                        question: "Quels sont les délais pour créer mon site ?",
                        answer: "En moyenne, comptez entre 2 et 8 semaines, selon la taille du site, les fonctionnalités à développer et les contenus à intégrer. Le temps de réalisation va également dépendre de votre réactivité à me transmettre certains éléments importants pour que j'avance : visuels, informations diverses, textes à intégrer...C'est un travail participatif."
                    },
                    {
                        question: "Travaillez-vous uniquement à Toulouse ?",
                        answer: "Non. Studio Tempo est basé à Toulouse, mais j'accompagne des clients partout en France. Les échanges et le suivi du projet peuvent parfaitement se faire à distance. Quand on travaille sur le web, la distance n'est pas du tout un problème : visios, mails, dials, téléphone sont de bons supports de communications modernes."
                    },
                    {
                        question: "Proposez-vous la maintenance après la mise en ligne ?",
                        answer: "Oui. Une maintenance peut être proposée à la demande selon vos besoins : mises à jour, petites modifications, suivi technique ou interventions ponctuelles."
                    },
                    {
                        question: "Est-ce que je saurai gérer mon site moi-même ?",
                        answer: "Oui. Une formation à la prise en main de votre site peut être prévue afin que vous puissiez gérer sereinement vos contenus au quotidien.Que ce soit un site wordPress ou une application Symfony, une formation est prévue."
                    },
                    {
                        question: "Puis-je payer mon projet en plusieurs fois ?",
                        answer: "Oui. Le paiement échelonné sans frais est possible afin de répartir plus confortablement le coût de votre projet. Cette solution repose sur la confiance et votre sérieux."
                    },
                    {
                        question: "Le référencement naturel est-il prévu dans la création du site ?",
                        answer: "Oui. Une optimisation SEO est prévue selon la formule choisie afin de poser de bonnes bases pour la visibilité de votre site sur les moteurs de recherche.Une optimisation poussée et régulière est également possible afin de suivre l'évolution et d'améliorer la performance de votre référencement naturel."
                    },
                    {
                        question: "Que dois-je fournir pour démarrer mon projet ?",
                        answer: "Nous définissons ensemble les éléments nécessaires : contenus, images, identité visuelle et fonctionnalités. Si tout n'est pas encore prêt, je vous accompagne pour déterminer ce qu'il reste à préparer."
                    }
                ] %}


                {% for faq in faqs %}

                    <details class="group bg-[#FBF8F3]
                                    border border-[#DED5C9]/80
                                    rounded-[1.2rem]
                                    overflow-hidden
                                    transition-all duration-300
                                    open:border-[#00687A]/25
                                    open:shadow-[0_12px_35px_rgba(0,104,122,0.06)]">

                        <summary class="flex items-center justify-between gap-6
                                        px-5 sm:px-7 py-5
                                        cursor-pointer
                                        list-none
                                        [&::-webkit-details-marker]:hidden">

                            <span class="flex items-center gap-4">

                                <span class="flex items-center justify-center
                                             w-8 h-8 shrink-0
                                             rounded-full
                                             bg-[#00687A]/10
                                             text-[#00687A]
                                             text-xs font-semibold">
                                    {{ '%02d'|format(loop.index) }}
                                </span>

                                <span class="font-semibold
                                             text-sm sm:text-base
                                             text-[#00687A]">
                                    {{ faq.question }}
                                </span>

                            </span>

                            <span class="relative flex items-center justify-center
                                         w-8 h-8 shrink-0
                                         rounded-full
                                         bg-[#EADBC9]
                                         text-[#C9653B]">

                                <span class="absolute w-3 h-[1.5px]
                                             bg-current">
                                </span>

                                <span class="absolute w-[1.5px] h-3
                                             bg-current
                                             transition-transform duration-300
                                             group-open:rotate-90
                                             group-open:opacity-0">
                                </span>

                            </span>

                        </summary>


                        <div class="px-5 sm:px-7 pb-6
                                    sm:pl-[4.75rem]">

                            <div class="h-px bg-[#DED5C9]/70 mb-4"></div>

                            <p class="text-sm leading-7
                                      text-ink-soft max-w-2xl">
                                {{ faq.answer }}
                            </p>

                        </div>

                    </details>

                {% endfor %}

            </div>

        </div>

    </section>


    {# =========================================================
       CTA FINAL
    ========================================================= #}
    <section class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pb-12">
        <div class="relative overflow-hidden rounded-[2.2rem] bg-[#EADBC9]
                    px-7 sm:px-10 lg:px-14 py-14 lg:py-16 reveal">

            <svg class="absolute inset-x-0 bottom-0 w-full h-40 opacity-90 pointer-events-none"
                 viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 110 C120 20,210 145,340 88 S520 35,650 105 S850 145,970 70 S1110 30,1200 80"
                      fill="none" stroke="#C9653B" stroke-width="1.4"/>
                <circle cx="340" cy="88" r="5" fill="#C9653B"/>
                <circle cx="650" cy="105" r="5" fill="#00687A"/>
                <circle cx="970" cy="70" r="5" fill="#C9653B"/>
            </svg>

            <div class="absolute -right-16 -bottom-28 w-80 h-80 rounded-full bg-[#D9C0A2]/35"></div>
            <div class="absolute right-24 -bottom-36 w-64 h-64 rounded-full bg-[#C9653B]/12"></div>
            <div class="absolute right-[-55px] top-[-45px] w-44 h-44 rounded-full bg-[#81998F]/20"></div>

            <div class="relative z-10 grid lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-16 items-end">

                <div>
                    <div class="flex items-center gap-4 mb-5">
                        <span class="w-9 h-[2px] bg-[#C9653B]"></span>
                        <span class="text-xs uppercase tracking-[0.2em] text-[#C9653B] font-semibold">
                            Un projet en tête ?
                        </span>
                    </div>

                    <h2 class="font-display text-3xl sm:text-4xl lg:text-[2.9rem]
                               leading-[1.08] text-[#00687A] max-w-xl">
                        Votre projet mérite mieux
                        qu'un tarif générique.
                    </h2>
                </div>

                <div>
                    <p class="text-ink-soft leading-7 max-w-md">
                        Échangeons sur vos besoins pour définir ensemble
                        la solution la plus adaptée, au bon rythme.
                    </p>

                    <a href="{{ path('app_contact') }}"
                       class="mt-7 inline-flex items-center gap-3 rounded-full
                              bg-[#00687A] text-white px-6 py-3.5
                              text-sm font-semibold transition-all duration-300
                              hover:bg-[#005966] hover:-translate-y-0.5 hover:shadow-lg">
                        Parlons de votre projet
                        <span>→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>
{% endblock %}
