<style>
    /* ------------------------------------------------------------
       Signature graphique Tempo — cadence / mouvement
    ------------------------------------------------------------ */
    .tempo-rhythm { display:flex; align-items:flex-end; gap:5px; height:34px; }
    .tempo-rhythm > span { display:block; width:7px; border-radius:999px; background:currentColor; transition:height .35s ease, transform .35s ease, opacity .35s ease; }
    .tempo-rhythm > span:nth-child(1){height:14px}.tempo-rhythm > span:nth-child(2){height:28px}.tempo-rhythm > span:nth-child(3){height:20px}.tempo-rhythm > span:nth-child(4){height:34px}
    .tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(1){height:25px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(2){height:16px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(3){height:32px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(4){height:22px}
    .tempo-beat { display:flex; align-items:center; gap:10px; color:rgba(196,91,54,.5); }
    .tempo-beat i { display:block; height:1px; border-radius:999px; background:currentColor; }
    @media (prefers-reduced-motion: reduce) { .tempo-rhythm > span { transition:none; } }

    /* ------------------------------------------------------------
       Couleurs accessibles (contraste AA) — en CSS pur pour ne pas
       dépendre du build Tailwind
       - terracotta "encre" : petits textes sur fond crème (≈ 4,8:1)
       - bronze : pastille 04 avec chiffre blanc (≈ 5,7:1)
    ------------------------------------------------------------ */
    .c-terra-ink { color:#A94F2C; }
    .bg-terra-ink { background-color:#A94F2C; color:#fff; }
    .bg-terra-ink:hover { background-color:#8F4124; }
    .bg-bronze { background-color:#7A6240; color:#fff; }
    .btn-outline-pine { border:1.5px solid #00687A; color:#00687A; }
    .btn-outline-pine:hover { background-color:#00687A; color:#fff; }

    /* Textes et tags des cartes services */
    .svc-text { color:#56615f; }
    .svc-tag { font-size:11px; }

    /* ------------------------------------------------------------
       Carrousel des services — CSS pur (ne dépend pas de Tailwind)
    ------------------------------------------------------------ */
    #services-carousel {
        display:flex;
        gap:1.5rem;
        margin-top:1rem;
        padding-bottom:1.5rem;
        max-width:100%;
        overflow-x:auto;
        overscroll-behavior-x:contain;
        scroll-snap-type:x mandatory;
        scroll-behavior:smooth;
        -webkit-overflow-scrolling:touch;
        scrollbar-width:thin;
    }
    #services-carousel > article { flex:0 0 100%; min-width:0; scroll-snap-align:start; }
    @media (min-width:768px)  { #services-carousel > article { flex-basis:calc((100% - 1.5rem) / 2); } }
    @media (min-width:1280px) { #services-carousel > article { flex-basis:calc((100% - 3rem) / 3); } }
    @media (prefers-reduced-motion: reduce) { #services-carousel { scroll-behavior:auto; } }
</style>

