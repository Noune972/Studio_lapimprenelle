                                        stroke="none"
                                    />

                                </svg>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>




   {# =========================================================
   MON HISTOIRE — VERSION FIDÈLE AU VISUEL
========================================================= #}

<section class="bg-[#F8F5EF] text-ink overflow-hidden">

    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-20 lg:py-28">




        {# =====================================================
           01 — LES DÉBUTS
           numéro | texte | petite image
        ===================================================== #}

        <article class="grid lg:grid-cols-[70px_minmax(0,1fr)_220px]
                        gap-7 lg:gap-10
                        items-center
                        py-12 lg:py-14
                        border-t border-[#D9C8A9]/60">


            {# NUMÉRO #}

            <div class="self-start">

                <span class="font-display
                             text-4xl
                             leading-none
                             text-terracotta/50">
                    01
                </span>

            </div>


            {# TEXTE #}

            <div class="max-w-2xl">

                <span class="block mb-4
                             text-xs tracking-[0.18em]
                             uppercase font-semibold
                             text-terracotta">
                    Les débuts
                </span>

                <p class="font-display
                          text-2xl sm:text-[1.0rem]
                          leading-[1.45]">

                    Depuis quatre ans, vous me connaissez à travers

                    <span class="text-terracotta">
                        La Pimprenelle
                    </span>

                    — mon site, mon blog, et l'accompagnement en rédaction
                    web SEO et en création de sites WordPress que j'y proposais.

                </p>

            </div>


            {# PETITE IMAGE DROITE #}

            <figure class="hidden lg:block
                           w-[220px]
                           justify-self-end">

                <div class="aspect-[4/3] overflow-hidden">

                    <img
                        src="{{ asset('images/lapimprenelle.png') }}"
                        alt="La Pimprenelle"
                        class="w-full h-full object-contain"
                    >

                </div>

            </figure>

        </article>



        {# =====================================================
           02 — TEMPO
           image gauche | contenu droite
        ===================================================== #}

        <article class="grid lg:grid-cols-[230px_minmax(0,1fr)]
                        gap-10 lg:gap-16
                        items-center
                        py-14 lg:py-16
                        border-t border-[#D9C8A9]/60">


            {# IMAGE VERTICALE GAUCHE #}

            <figure class="hidden lg:block
                           w-[230px]
                           justify-self-start">

                <div class="aspect-[4/5] overflow-hidden">

                    <img
                        src="{{ asset('images/logo_tempo.png') }}"
                        alt=""
                        class="w-full h-full object-cover"
                    >

                </div>

            </figure>


            {# CONTENU #}

            <div class="max-w-2xl">


                {# En-tête avec numéro #}

                <div class="grid grid-cols-[55px_1fr]
                            gap-5 mb-7">

                    <span class="font-display
                                 text-4xl
                                 leading-none
                                 text-terracotta/50">
                        02
                    </span>


                    <div class="border-l border-terracotta/50 pl-5">

                        <span class="block mb-3
                                     text-xs tracking-[0.18em]
                                     uppercase font-semibold
                                     text-terracotta">
                            L'évolution
                        </span>

                        <h3 class="font-display
                                   text-3xl sm:text-[2.25rem]
                                   leading-[1.15]">

                            Et puis est venu le temps de

                            <span class="text-terracotta">
                                Tempo.
                            </span>

                        </h3>

                    </div>

                </div>


                {# Paragraphes alignés sous le titre #}

                <div class="lg:pl-[80px]
                            space-y-5
                            text-base sm:text-[1.0625rem]
                            leading-7 text-ink-soft">

                    <p>
                        Cette aventure évolue aujourd'hui : je vous présente
                        <strong class="font-medium text-ink">
                            Tempo
                        </strong>,
                        une agence web qui porte cette même exigence plus loin,
                        avec une corde supplémentaire à son arc — le développement
                        d'applications Symfony, aux côtés de mon expertise WordPress.
                    </p>

                    <p>
                        Cette évolution ne doit rien au hasard : je me suis formée
                        durant seize mois au métier de développeuse web et web mobile,
                        animée par la volonté de porter mes projets jusqu'à leur terme
                        et de donner corps à des réalisations numériques solides,
                        de la conception à la mise en œuvre.
                    </p>

                    <p class="font-medium text-ink">
                        Je me sens aujourd'hui prête à vous montrer ce que j'ai appris,
                        et surtout à le mettre au service de vos ambitions.
                    </p>

                </div>

            </div>

        </article>



        {# =====================================================
           03 — INFLUENCES
           numéro | texte | petite image
        ===================================================== #}

        <article class="grid lg:grid-cols-[70px_minmax(0,1fr)_220px]
                        gap-7 lg:gap-10
                        items-center
                        py-14 lg:py-16
                        border-y border-[#D9C8A9]/60">


            {# NUMÉRO #}

            <div class="self-start">

                <span class="font-display
                             text-4xl
                             leading-none
                             text-terracotta/50">
                    03
                </span>

            </div>


            {# TEXTE #}

            <div class="max-w-2xl">

                <span class="block mb-4
                             text-xs tracking-[0.18em]
                             uppercase font-semibold
                             text-terracotta">
                    Mes influences
                </span>

                <h3 class="font-display
                           text-3xl sm:text-[2.25rem]
                           leading-[1.15]
                           mb-7">

                    L'art, la culture

                    <span class="text-terracotta">
                        et le regard sur le monde.
                    </span>

                </h3>


                <div class="space-y-5
                            text-base sm:text-[1.0625rem]
                            leading-7 text-ink-soft">

                    <p>
                        Cette exigence professionnelle puise sa source dans
                        un attachement profond à l'univers artistique.
                        J'affectionne particulièrement les impressionnistes —
                        Monet, Van Gogh, Caillebotte — ainsi que le mouvement
                        baroque et l'œuvre du Caravage, dont j'admire la maîtrise
                        du clair-obscur.
                    </p>

                    <p>
                        Les écrits de Frantz Fanon et d'Aimé Césaire ont,
                        quant à eux, nourri en profondeur ma réflexion sur
                        les préjugés, les stéréotypes et les rapports humains
                        au sein du monde professionnel.
                    </p>

                </div>

            </div>


            {# PETITE IMAGE DROITE #}

            <figure class="hidden lg:block
                           w-[220px]
                           justify-self-end">

                <div class="aspect-[4/5] overflow-hidden">

                    <img
                        src="{{ asset('images/art.png') }}"
                        alt=""
                        class="w-full h-full object-cover"
                    >

                </div>

            </figure>

        </article>

    </div>



    {# =========================================================
       CONCLUSION — BANDE BLEUE COMME LE VISUEL
    ========================================================= #}

    <div class="bg-[#00687A] text-[#F8F5EF]">

        <div class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12
                    py-14 lg:py-16">

            <div class="grid lg:grid-cols-[70px_minmax(0,1fr)_220px]
                        gap-7 lg:gap-10
                        items-start">


                <div class="pt-5">

                    <span class="block w-10 h-px bg-terracotta"></span>

                </div>


                <blockquote class="max-w-3xl">

                    <p class="font-display
                              text-2xl sm:text-3xl
                              lg:text-[2 rem]
                              leading-[1.35]">

                        "J’ai choisi de tracer mon propre chemin pour mettre mes compétences au service de vos projets, avec une conviction simple : concevoir des solutions web fiables, soignées et pensées pour 

                        <span class="text-[#E69A67]">
                            répondre pleinement à vos besoins."
                        </span>

                    </p>

                </blockquote>


                {# espace volontaire à droite #}
                <div class="hidden lg:block"></div>

            </div>

        </div>

    </div>

</section>
   

   


    {# =========================================================
       PHILOSOPHIE
    ========================================================= #}

    <section class="bg-white py-24 lg:py-32">

        <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center reveal">

            <div class="text-terracotta text-5xl font-display mb-5">
                "
            </div>

            <p class="font-display text-3xl sm:text-4xl lg:text-3xl leading-[1.15] tracking-tight">
                Un site efficace ne se contente pas d'être beau.
                Il doit
                <span class="text-terracotta">performer.</span>
                Architecture claire, expérience fluide,
                contenu optimisé, référencement maîtrisé
                et parcours pensé pour convertir.
            </p>

            <div class="mt-8 text-sm text-ink-soft">
                — Nathalie, fondatrice de Tempo
            </div>

        </div>

    </section>


    {# =========================================================
       CTA FINAL — BLEU DU LOGO
    ========================================================= #}

    <section class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pb-20 lg:pb-28">

        <div class="relative overflow-hidden
                    bg-[#00687A]
                    rounded-[2.5rem]
                    px-8 py-16 md:px-14 lg:px-20 lg:py-20
                    text-cream reveal">

            <div class="absolute -top-20 -right-20 w-56 h-56 rounded-full border border-white/10"></div>

            <div class="absolute -bottom-24 -left-16 w-64 h-64 rounded-full bg-white/5"></div>


            <div class="relative z-10 text-center">

                <div class="text-xs tracking-[0.25em] text-white/70 font-medium mb-5">
                    UN PROJET ?
                </div>

                <h2 class="font-display text-4xl md:text-5xl leading-tight mb-6">
                    Parlons de votre projet.
                </h2>

                <p class="text-sm md:text-base text-white/80 leading-relaxed max-w-xl mx-auto mb-9">
                    Vous avez besoin d'un site web ou de contenus pour développer votre visibilité ?
                    Échangeons autour de vos besoins.
                </p>


                <a href="mailto:contact@tempo-agence.fr"
                   class="group inline-flex items-center gap-3
                          bg-cream text-ink
                          px-7 py-3.5 rounded-full
                          text-sm font-medium
                          hover:bg-white hover:-translate-y-0.5
                          transition-all duration-300">

                    Me contacter

                    <span class="text-base transition-transform duration-300 group-hover:translate-x-1">
                        →
                    </span>

                </a>

            </div>

        </div>

    </section>

</div>

