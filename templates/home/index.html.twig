{# Carrousel : délégation d'événements (compatible Turbo, un seul écouteur) #}
<script>
(function () {
    if (window.__servicesCarouselInit) return;
    window.__servicesCarouselInit = true;

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('#services-prev, #services-next');
        if (!btn) return;

        const carousel = document.getElementById('services-carousel');
        const card = carousel && carousel.querySelector('article');
        if (!card) return;

        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0;
        const step = card.getBoundingClientRect().width + gap;

        carousel.scrollBy({
            left: btn.id === 'services-next' ? step : -step,
            behavior: 'smooth'
        });
    });
})();
</script>

