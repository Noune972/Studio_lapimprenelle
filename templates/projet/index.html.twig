{% extends 'base.html.twig' %}

{% block title %} Réalisations web WordPress & Symfony — Studio Tempo {% endblock %}

{% block meta_description %}
    Découvrez les sites WordPress et applications Symfony réalisés par Studio Tempo pour accompagner les entreprises dans leurs projets numériques.
{% endblock %}

{% block body %}

<style>
    /* Réalisations — variation éditoriale du langage Studio Tempo */
    .portfolio-tick {
        display: inline-block;
        width: 3px;
        height: 18px;
        border-radius: 999px;
        background: currentColor;
        transform: rotate(18deg);
    }
    .portfolio-track {
        position: relative;
        height: 1px;
        background: rgba(0,104,122,.16);
    }
    .portfolio-track::before,
    .portfolio-track::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: #C9653B;
        transform: translateY(-50%);
    }
    .portfolio-track::before { left: 14%; }
    .portfolio-track::after { right: 24%; }

    .project-card:nth-child(4n+1) .project-stage { background: #E8D6C4; }
    .project-card:nth-child(4n+2) .project-stage { background: #DCE8E5; }
    .project-card:nth-child(4n+3) .project-stage { background: #EAD8D0; }
    .project-card:nth-child(4n)   .project-stage { background: #E7E0C9; }

    @media (min-width: 768px) {
        .project-card:nth-child(even) { transform: translateY(4.5rem); }
        .project-grid { margin-bottom: 4.5rem; }
    }

    .project-index {
        font-variant-numeric: tabular-nums;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }

    .project-stage::after {
        content: "";
        position: absolute;
        width: 9rem;
        height: 9rem;
        right: -4.25rem;
        bottom: -4.5rem;
        border: 1px solid rgba(0,104,122,.16);
        transform: rotate(28deg);
        border-radius: 2.5rem;
        pointer-events: none;
        transition: transform .6s ease;
    }
    .project-card:hover .project-stage::after {
        transform: rotate(38deg) translate(-.3rem,-.3rem);
    }

    .editorial-mark {
        position: absolute;
        pointer-events: none;
        opacity: .18;
    }
    .editorial-mark span {
        display: block;
        height: 1px;
        background: currentColor;
        transform-origin: left center;
    }
    .editorial-mark span:nth-child(1) { width: 5rem; transform: rotate(-8deg); }
    .editorial-mark span:nth-child(2) { width: 8rem; margin-top: 1rem; transform: rotate(5deg); }
    .editorial-mark span:nth-child(3) { width: 3rem; margin-top: 1rem; transform: rotate(-14deg); }

    @media (prefers-reduced-motion: reduce) {
        .project-card:nth-child(even) { transform: none; }
        .project-stage::after { transition: none; }
    }
</style>


<div class="bg-[#F7F3EC] text-ink overflow-hidden">


    {# =========================================================
       HERO — RYTHME ÉDITORIAL
    ========================================================= #}

    <section class="relative max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pt-16 sm:pt-20 lg:pt-28
                    pb-14 lg:pb-20">

        <div class="grid lg:grid-cols-[1.15fr_.85fr] gap-10 lg:gap-20 items-end">

            <div class="relative reveal">

                <div class="flex items-center gap-3 mb-7">
                    <span class="portfolio-tick text-terracotta"></span>
                    <span class="text-xs tracking-[0.22em] uppercase font-semibold text-terracotta">
                        Réalisations
                    </span>
                </div>

                <h1 class="font-display
                           text-5xl sm:text-6xl lg:text-[4.2rem]
                           leading-[0.96]
                           tracking-[-0.045em]">
                    Des projets pensés
                    <span class="block text-[#00687A]">
                        pour convertir.
                    </span>
                </h1>

                <div class="portfolio-track mt-9 max-w-md" aria-hidden="true"></div>

            </div>

            <div class="relative reveal">
                <div class="absolute -left-5 sm:-left-8 top-1
                            w-[3px] h-16 rounded-full
                            bg-terracotta/70 rotate-[12deg]"
                     aria-hidden="true"></div>

                <p class="max-w-xl
                          text-base sm:text-lg
                          leading-8
                          text-ink-soft">
                    Sites vitrines, e-commerce et applications web :
                    découvrez une sélection de projets conçus pour répondre
                    à des objectifs concrets et offrir une expérience claire,
                    élégante et efficace.
                </p>

                <div class="mt-7 flex items-center gap-3 text-[10px]
                            tracking-[0.18em] uppercase text-[#00687A]/55"
                     aria-hidden="true">
                    <span>01</span>
                    <span class="w-8 h-px bg-current"></span>
                    <span>02</span>
                    <span class="w-14 h-px bg-current"></span>
                    <span>03</span>
                </div>
            </div>

        </div>

    </section>


    {# =========================================================
       TYPES DE PROJETS
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pb-12 lg:pb-14">

        <div class="flex flex-wrap items-center gap-2.5 reveal">

            <span class="inline-flex
                         items-center
                         rounded-lg
                         bg-terracotta
                         text-white
                         text-sm font-medium
                         px-5 py-2.5">
                Quelques projets
            </span>

            <span class="inline-flex
                         items-center
                         rounded-lg
                         border border-[#00687A]/15
                         bg-[#00687A]/[0.045]
                         text-ink-soft
                         text-sm
                         px-5 py-2.5">
                WordPress
            </span>

            <span class="inline-flex
                         items-center
                         rounded-lg
                         border border-[#00687A]/15
                         bg-[#00687A]/[0.045]
                         text-ink-soft
                         text-sm
                         px-5 py-2.5">
                Symfony
            </span>

        </div>

    </section>


    {# =========================================================
       PROJETS
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pb-24 lg:pb-32">

        {% if projets is not empty %}

            <div class="project-grid grid
                        md:grid-cols-2
                        gap-x-8 lg:gap-x-12
                        gap-y-14 lg:gap-y-20">

                {% for projet in projets %}

                    <article class="project-card group reveal">


                        {# =================================================
                           ZONE VISUELLE
                        ================================================= #}

                        <div class="project-stage relative
                                    rounded-[1.35rem]
                                    overflow-hidden
                                    px-5 sm:px-7 lg:px-8
                                    pt-8 sm:pt-10
                                    pb-5 sm:pb-6
                                    transition-transform duration-500">


                            {# NUMÉRO DU PROJET #}

                            <div class="absolute top-5 left-5 flex items-start gap-3 z-10">
                                <span class="project-index
                                             text-[10px]
                                             tracking-[0.18em]
                                             uppercase
                                             font-semibold
                                             text-[#00687A]/45">
                                    {{ '%02d'|format(loop.index) }}
                                </span>
                                <span class="block w-[2px] h-8 bg-terracotta/65 rotate-[14deg]"
                                      aria-hidden="true"></span>
                            </div>


                            {# =================================================
                               L'ORDINATEUR RESTE CLIQUABLE
                               MAIS AUCUN "VOIR LE SITE" SUR L'IMAGE
                            ================================================= #}

                            {% if projet.lien %}

                                <a
                                    href="{{ projet.lien }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block"
                                    aria-label="Visiter le site {{ projet.titre }}"
                                >

                            {% endif %}


                            {# =================================================
                               MOCKUP ORDINATEUR
                            ================================================= #}

                            <div class="relative
                                        mx-auto
                                        max-w-[520px]
                                        mt-5
                                        transition-transform
                                        duration-500
                                        ease-out
                                        group-hover:-translate-y-1">


                                {# =============================================
                                   ÉCRAN
                                ============================================= #}

                                <div class="relative
                                            bg-[#181A19]
                                            rounded-t-[15px]
                                            p-[6px]
                                            shadow-[0_22px_45px_rgba(23,32,30,0.18)]">


                                    {# WEBCAM #}

                                    <span class="absolute
                                                 top-[2px]
                                                 left-1/2
                                                 -translate-x-1/2
                                                 w-[3px]
                                                 h-[3px]
                                                 rounded-full
                                                 bg-white/25
                                                 z-20">
                                    </span>


                                    {# =========================================
                                       CONTENU DE L'ÉCRAN
                                    ========================================= #}

                                    <div class="relative
                                                aspect-[16/10]
                                                overflow-hidden
                                                rounded-t-[9px]
                                                bg-[#F7F3EC]">


                                        {% if projet.image %}

                                            <img
                                                src="{{ asset('uploads/projets/' ~ projet.image) }}"
                                                alt="Aperçu du projet {{ projet.titre }}"
                                                loading="lazy"
                                                class="w-full
                                                       h-full
                                                       object-cover
                                                       object-top
                                                       transition-transform
                                                       duration-700
                                                       ease-out
                                                       group-hover:scale-[1.025]"
                                            >

                                        {% else %}

                                            <div class="absolute
                                                        inset-0
                                                        flex
                                                        flex-col
                                                        items-center
                                                        justify-center
                                                        text-center
                                                        px-8
                                                        bg-[#F7F3EC]">

                                                <div class="flex
                                                            items-center
                                                            justify-center
                                                            w-12 h-12
                                                            rounded-full
                                                            bg-[#00687A]/10
                                                            text-[#00687A]
                                                            mb-4">

                                                    <svg
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="1.5"
                                                        class="w-5 h-5"
                                                        aria-hidden="true"
                                                    >
                                                        <rect
                                                            x="3"
                                                            y="4"
                                                            width="18"
                                                            height="14"
                                                            rx="2"
                                                        />

                                                        <path d="M8 21h8"/>
                                                        <path d="M12 18v3"/>
                                                    </svg>

                                                </div>

                                                <span class="font-display
                                                             text-xl
                                                             text-ink">
                                                    {{ projet.titre }}
                                                </span>

                                                <span class="mt-2
                                                             text-xs
                                                             text-ink-soft">
                                                    Aperçu bientôt disponible
                                                </span>

                                            </div>

                                        {% endif %}


                                        {# REFLET SUBTIL SUR L'ÉCRAN #}

                                        <div class="absolute
                                                    inset-0
                                                    pointer-events-none
                                                    bg-gradient-to-tr
                                                    from-transparent
                                                    via-white/[0.025]
                                                    to-white/[0.10]">
                                        </div>


                                    </div>

                                </div>


                                {# =============================================
                                   BASE DE L'ORDINATEUR
                                ============================================= #}

                                <div class="relative
                                            h-[11px]
                                            bg-gradient-to-b
                                            from-[#D8D8D6]
                                            via-[#C4C4C2]
                                            to-[#A7A7A5]
                                            rounded-b-md">

                                    <div class="absolute
                                                top-0
                                                left-1/2
                                                -translate-x-1/2
                                                w-16
                                                h-[4px]
                                                bg-[#929290]
                                                rounded-b-md">
                                    </div>

                                </div>


                                {# PETIT EFFET DE PERSPECTIVE #}

                                <div class="mx-auto
                                            w-[94%]
                                            h-[4px]
                                            bg-[#9B9B99]
                                            rounded-b-[50%]">
                                </div>


                                {# OMBRE SOUS L'ORDINATEUR #}

                                <div class="mx-auto
                                            w-[78%]
                                            h-4
                                            -mt-1
                                            rounded-full
                                            bg-black/15
                                            blur-lg">
                                </div>


                            </div>


                            {% if projet.lien %}

                                </a>

                            {% endif %}


                        </div>


                        {# =================================================
                           INFORMATIONS DU PROJET
                        ================================================= #}

                        <div class="pt-6 sm:pt-7">

                            <div class="flex
                                        items-start
                                        justify-between
                                        gap-5 sm:gap-6">

                                <div class="min-w-0">


                                    {# TYPE DU SITE #}

                                    {% if projet.typeDeSite %}

                                        <span class="block
                                                     mb-2
                                                     text-[10px]
                                                     tracking-[0.18em]
                                                     uppercase
                                                     font-semibold
                                                     text-terracotta">

                                            {% if projet.typeDeSite == 'wordpress' %}

                                                WordPress

                                            {% elseif projet.typeDeSite == 'symfony' %}

                                                Symfony

                                            {% else %}

                                                {{ projet.typeDeSite }}

                                            {% endif %}

                                        </span>

                                    {% endif %}


                                    {# TITRE #}

                                    <h2 class="font-display
                                               text-2xl sm:text-[1.8rem]
                                               leading-tight
                                               transition-colors
                                               duration-300
                                               group-hover:text-terracotta">

                                        {{ projet.titre }}

                                    </h2>


                                    {# DESCRIPTION #}

                                    {% if projet.description %}

                                        <p class="mt-3
                                                  max-w-md
                                                  text-sm sm:text-base
                                                  leading-7
                                                  text-ink-soft">

                                            {{ projet.description }}

                                        </p>

                                    {% endif %}


                                    {# =========================================
                                       SEUL "VOIR LE SITE" VISIBLE
                                       IL RESTE SOUS LA DESCRIPTION
                                    ========================================= #}

                                    {% if projet.lien %}

                                        <a
                                            href="{{ projet.lien }}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="group/link
                                                   inline-flex
                                                   items-center
                                                   gap-2
                                                   mt-5
                                                   text-sm
                                                   font-semibold
                                                   text-[#00687A]
                                                   hover:text-terracotta
                                                   transition-colors
                                                   duration-300"
                                        >

                                            <span>
                                                Voir le site
                                            </span>

                                            <svg
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="w-4 h-4
                                                       transition-transform
                                                       duration-300
                                                       group-hover/link:translate-x-0.5
                                                       group-hover/link:-translate-y-0.5"
                                                aria-hidden="true"
                                            >
                                                <path d="M7 17L17 7"/>
                                                <path d="M8 7h9v9"/>
                                            </svg>

                                        </a>

                                    {% endif %}


                                </div>


                                {# =================================================
                                   BOUTON ROND ↗
                                ================================================= #}

                                {% if projet.lien %}

                                    <a
                                        href="{{ projet.lien }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label="Visiter le site {{ projet.titre }}"
                                        class="flex
                                               shrink-0
                                               w-11 h-11
                                               items-center
                                               justify-center
                                               rounded-full
                                               border
                                               border-[#D9C8A9]
                                               text-terracotta
                                               transition-all
                                               duration-300
                                               hover:bg-terracotta
                                               hover:text-white
                                               hover:border-terracotta
                                               hover:-translate-y-0.5"
                                    >

                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.7"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="w-4 h-4"
                                            aria-hidden="true"
                                        >
                                            <path d="M7 17L17 7"/>
                                            <path d="M8 7h9v9"/>
                                        </svg>

                                    </a>

                                {% else %}

                                    <span class="flex
                                                 shrink-0
                                                 w-11 h-11
                                                 items-center
                                                 justify-center
                                                 rounded-full
                                                 border
                                                 border-[#D9C8A9]/50
                                                 text-ink/20">

                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.7"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="w-4 h-4"
                                            aria-hidden="true"
                                        >
                                            <path d="M7 17L17 7"/>
                                            <path d="M8 7h9v9"/>
                                        </svg>

                                    </span>

                                {% endif %}

                            </div>


                            {# LIGNE DÉCORATIVE #}

                            <div class="mt-7 flex items-center gap-3" aria-hidden="true">
                                <span class="h-px flex-1 bg-[#00687A]/15"></span>
                                <span class="w-2 h-2 border border-terracotta/55 rotate-45"></span>
                            </div>

                        </div>


                    </article>

                {% endfor %}

            </div>


        {% else %}


            {# =================================================
               AUCUN PROJET
            ================================================= #}

            <div class="rounded-[2rem]
                        bg-[#EEE7DC]
                        px-8
                        py-16 sm:py-20
                        text-center
                        reveal">

                <span class="text-xs
                             tracking-[0.2em]
                             uppercase
                             font-semibold
                             text-terracotta">
                    Portfolio
                </span>

                <h2 class="mt-4
                           font-display
                           text-3xl sm:text-4xl">
                    Les projets arrivent bientôt.
                </h2>

                <p class="mt-4
                          max-w-lg
                          mx-auto
                          text-base
                          leading-7
                          text-ink-soft">

                    De nouvelles réalisations sont actuellement
                    en préparation et seront présentées ici prochainement.

                </p>

            </div>


        {% endif %}

    </section>


    {# =========================================================
       PHILOSOPHIE — PAUSE DANS LE RYTHME
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pb-24 lg:pb-28">

        <div class="relative overflow-hidden
                    rounded-[2rem]
                    bg-[#E9D6CB]
                    px-7 sm:px-10 lg:px-14
                    py-10 sm:py-12 lg:py-14
                    reveal">

            <div class="editorial-mark text-[#00687A] right-8 top-9 hidden sm:block"
                 aria-hidden="true">
                <span></span><span></span><span></span>
            </div>

            <div class="grid
                        lg:grid-cols-[0.72fr_1.28fr]
                        gap-8 lg:gap-20
                        items-start">

                <div>
                    <div class="flex items-center gap-3">
                        <span class="portfolio-tick text-[#00687A]"></span>
                        <span class="text-xs tracking-[0.22em] uppercase font-semibold text-[#00687A]">
                            Ma vision
                        </span>
                    </div>
                </div>

                <div>
                    <h2 class="font-display
                               text-3xl sm:text-[2.5rem]
                               leading-[1.15]">
                        Pas seulement un joli site,
                        <span class="text-[#00687A]">
                            un véritable outil.
                        </span>
                    </h2>

                    <p class="mt-6 max-w-2xl
                              text-base sm:text-lg
                              leading-8 text-ink-soft">
                        Chaque projet est conçu autour de votre activité,
                        de vos utilisateurs et de vos objectifs.
                        Le design donne envie de rester, mais la structure,
                        les performances et l'expérience doivent surtout
                        permettre au site d'être réellement utile.
                    </p>
                </div>

            </div>
        </div>

    </section>


    {# =========================================================
       CTA FINAL — TERRACOTTA / ÉDITORIAL
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pb-24 lg:pb-32">

        <div class="relative overflow-hidden
                    rounded-[2.5rem]
                    bg-[#C9653B]
                    text-white
                    px-7 sm:px-10 lg:px-16
                    py-12 sm:py-14 lg:py-16
                    reveal">

            <div class="absolute right-8 top-8 hidden sm:flex
                        items-end gap-2 opacity-20"
                 aria-hidden="true">
                <span class="w-px h-7 bg-white rotate-[10deg]"></span>
                <span class="w-px h-12 bg-white -rotate-[7deg]"></span>
                <span class="w-px h-5 bg-white rotate-[15deg]"></span>
                <span class="w-px h-16 bg-white -rotate-[4deg]"></span>
            </div>

            <div class="relative z-10
                        flex flex-col lg:flex-row
                        lg:items-end lg:justify-between
                        gap-10">

                <div class="max-w-2xl">
                    <span class="text-xs tracking-[0.22em] uppercase font-semibold text-white/65">
                        Votre projet
                    </span>

                    <h2 class="mt-5
                               font-display
                               text-4xl sm:text-5xl lg:text-[3.5rem]
                               leading-[1.05]">
                        Et si le prochain
                        <span class="block text-[#F7F3EC]">
                            était le vôtre ?
                        </span>
                    </h2>

                    <p class="mt-6 max-w-xl
                              text-base sm:text-lg
                              leading-8 text-white/75">
                        Parlons de votre activité, de vos besoins
                        et de ce que votre futur site doit réellement
                        accomplir.
                    </p>
                </div>

                <a href="{{ path('app_contact') }}"
                   class="inline-flex
                          self-start lg:self-auto
                          items-center gap-3
                          rounded-full
                          bg-[#F7F3EC]
                          text-[#00687A]
                          px-6 py-3.5
                          text-sm font-semibold
                          hover:-translate-y-0.5
                          hover:shadow-lg
                          transition-all duration-300">
                    Discutons de votre projet

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="w-4 h-4"
                         aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path d="M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>


</div>

{% endblock %}