<style>
    /* Éventail interactif des réalisations */
    #realisations .tempo-fan {
        position: relative;
        height: 350px;
        width: 100%;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
    }

    #realisations .tempo-fan-card {
        position: absolute;
        top: 12%;
        left: 24%;
        width: 52%;
        height: 270px;
        transform-origin: center 85%;
        transition:
            transform 450ms cubic-bezier(.22, 1, .36, 1),
            left 450ms cubic-bezier(.22, 1, .36, 1),
            top 450ms cubic-bezier(.22, 1, .36, 1),
            box-shadow 450ms ease;
        will-change: transform;
    }

    /* Carte à gauche */
    #realisations .tempo-fan-card[data-position="left"] {
        left: 2%;
        top: 16%;
        transform: rotate(-11deg) scale(.94);
        z-index: 1;
    }

    /* Carte centrale */
    #realisations .tempo-fan-card[data-position="center"] {
        left: 24%;
        top: 5%;
        transform: rotate(0deg) scale(1);
        z-index: 3;
        box-shadow: 0 22px 50px rgba(23, 40, 36, .23);
    }

    /* Carte à droite */
    #realisations .tempo-fan-card[data-position="right"] {
        left: 46%;
        top: 16%;
        transform: rotate(11deg) scale(.94);
        z-index: 2;
    }

    #realisations .tempo-fan-card:focus-within {
        z-index: 5;
    }

    @media (min-width: 640px) {
        #realisations .tempo-fan {
            height: 460px;
        }

        #realisations .tempo-fan-card {
            height: 370px;
        }
    }

    @media (min-width: 1024px) {
        #realisations .tempo-fan {
            height: 490px;
        }

        #realisations .tempo-fan-card {
            height: 390px;
        }

