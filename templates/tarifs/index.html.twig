{% extends 'base.html.twig' %}

{% block title %}Tarifs création de site internet | Tempo{% endblock %}

{% block body %}

{# =========================================================
   HERO
========================================================= #}
<section class="px-4 sm:px-6 lg:px-8 pt-6">

    <div class="relative max-w-7xl mx-auto overflow-hidden
                bg-[#EFE7DA] rounded-[2rem] lg:rounded-[2.5rem]">

        {# Formes décoratives #}
        <div class="absolute -top-16 -right-12 w-56 h-56
                    rounded-full bg-[#C96A3E]/15"></div>

        <div class="absolute top-20 right-[12%] w-20 h-20
                    rounded-full border border-[#C96A3E]/40"></div>

        <div class="absolute -bottom-16 left-[8%] w-44 h-44
                    rounded-full bg-[#00687A]/10"></div>

        <div class="absolute bottom-10 right-12 hidden lg:block
                    w-24 h-24 rotate-12 rounded-[1.8rem]
                    border border-[#00687A]/20"></div>

        <div class="relative px-6 sm:px-10 lg:px-16 py-16 lg:py-20">

            <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center">

                {# Texte #}
                <div class="reveal">

                    <div class="inline-flex items-center gap-3 mb-6">
                        <span class="w-8 h-[2px] bg-[#C96A3E]"></span>

                        <span class="text-xs uppercase tracking-[0.18em]
                                     text-[#C96A3E] font-semibold">
                            Tarifs & prestations
                        </span>
                    </div>

                    <h1 class="font-display
                               text-4xl sm:text-5xl lg:text-[3.5rem]
                               leading-[1.05] tracking-tight text-ink">
                        Un budget clair pour
                        <span class="text-[#00687A]">
                            donner vie à votre projet.
                        </span>
                    </h1>

                    <p class="mt-6 text-base sm:text-lg leading-7
                              text-ink-soft max-w-2xl">
                        Des tarifs de départ pour vous permettre de vous projeter,
                        puis un devis adapté à vos besoins, vos objectifs
                        et aux fonctionnalités de votre projet.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">

                        <a href="{{ path('app_contact') }}"
                           class="inline-flex items-center gap-2
                                  rounded-full bg-[#00687A] text-white
                                  px-6 py-3.5 text-sm font-semibold
                                  transition-all duration-300
                                  hover:bg-[#005966]
                                  hover:-translate-y-0.5">
                            Parlons de votre projet
                            <span>→</span>
                        </a>

                        <a href="#offres"
                           class="inline-flex items-center gap-2
                                  rounded-full border border-[#C96A3E]/50
                                  text-[#C96A3E]
                                  px-6 py-3.5 text-sm font-semibold
                                  transition hover:bg-[#C96A3E]
                                  hover:text-white">
                            Voir les tarifs
                            <span>↓</span>
                        </a>

                    </div>

                </div>


                {# Composition graphique #}
                <div class="relative hidden lg:flex justify-center reveal">

                    <div class="relative w-[340px] h-[330px]">

                        {# grande forme #}
                        <div class="absolute top-2 right-2
                                    w-64 h-64
                                    bg-[#00687A]
                                    rounded-[3rem_7rem_3rem_7rem]
                                    rotate-3"></div>

                        {# carte prix #}
                        <div class="absolute top-14 left-0
                                    w-60
                                    bg-[#F7F3EC]
                                    rounded-[1.7rem]
                                    p-7
                                    shadow-xl
                                    -rotate-3">

                            <p class="text-xs uppercase tracking-[0.18em]
                                      text-[#C96A3E] mb-5">
                                À partir de
                            </p>

                            <p class="font-display text-4xl text-ink">
                                800 €
                            </p>

                            <p class="text-sm text-ink-soft mt-2">
                                pour votre premier site
                            </p>

                            <div class="mt-6 h-px bg-[#D9C8A9]"></div>

                            <p class="mt-4 text-xs text-ink-soft">
                                Design · Responsive · SEO
                            </p>

                        </div>

                        {# rond terracotta #}
                        <div class="absolute bottom-3 right-5
                                    w-28 h-28 rounded-full
                                    bg-[#C96A3E]
                                    flex items-center justify-center
                                    text-center text-white
                                    rotate-6">

                            <span class="font-display text-lg leading-5">
                                Votre idée.<br>
                                Mon expertise.
                            </span>

                        </div>

                        {# petit point #}
                        <div class="absolute top-0 left-20
                                    w-5 h-5 rounded-full
                                    bg-[#C96A3E]"></div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>


{# =========================================================
   PETITE BANDE DE PROMESSES
========================================================= #}
<section class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-12">

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

        {% set promises = [
            ['01', 'Design personnalisé'],
            ['02', 'Responsive'],
            ['03', 'SEO technique'],
            ['04', 'Accompagnement']
        ] %}

        {% for item in promises %}

            <div class="reveal flex items-center gap-4
                        border-b border-[#D9C8A9]
                        py-4">

                <span class="font-display text-xl text-[#C96A3E]">
                    {{ item[0] }}
                </span>

                <span class="text-sm text-ink">
                    {{ item[1] }}
                </span>

            </div>

        {% endfor %}

    </div>
</section>


{# =========================================================
   INTRO
========================================================= #}
<section id="offres"
         class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12
                pt-10 pb-14">

    <div class="grid lg:grid-cols-[0.65fr_1.35fr] gap-8 lg:gap-20">

        <div class="reveal">

            <div class="inline-flex items-center gap-3">

                <span class="w-7 h-[2px] bg-[#C96A3E]"></span>

                <p class="text-xs uppercase tracking-[0.18em]
                          text-[#C96A3E] font-semibold">
                    Les offres
                </p>

            </div>

        </div>

        <div class="reveal">

            <h2 class="font-display
                       text-3xl sm:text-4xl lg:text-[2.8rem]
                       leading-[1.1] text-ink max-w-3xl">
                À chaque projet,
                <span class="text-[#00687A]">
                    sa solution.
                </span>
            </h2>

            <p class="mt-5 text-ink-soft leading-7 max-w-3xl">
                Du site essentiel à l'application métier, je construis une solution
                adaptée à votre activité, sans ajouter de fonctionnalités inutiles.
            </p>

        </div>

    </div>
</section>


{# =========================================================
   3 OFFRES PRINCIPALES
========================================================= #}
<section class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pb-20">

    <div class="grid lg:grid-cols-3 gap-6 items-stretch">


        {# ONE PAGE #}
        <article class="reveal relative overflow-hidden
                        bg-[#EFE7DA]
                        rounded-[2rem]
                        p-7 lg:p-8">

            <div class="absolute -right-10 -top-10
