{% extends 'base.html.twig' %}

{% block title %}
    Blog WordPress, Symfony & SEO — Studio Tempo
{% endblock %}

{% block meta_description %}
    Découvrez le blog Studio Tempo : conseils en création de sites web, WordPress, Symfony, SEO et stratégie digitale pour développer votre présence en ligne.
{% endblock %}


{% block body %}

<div class="bg-[#F7F3EC] text-ink overflow-hidden">


    {# =========================================================
       HERO — ÉDITORIAL & ÉPURÉ
    ========================================================= #}

    <section class="relative
                    max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12
                    pt-16 sm:pt-20 lg:pt-28
                    pb-16 lg:pb-20">

        {# Petit repère décoratif #}
        <div class="absolute
                    right-[8%] top-16
                    hidden lg:block
                    w-28 h-28
                    rounded-[2rem]
                    border border-[#00687A]/10
                    rotate-[18deg]"
             aria-hidden="true">
        </div>


        <div class="relative max-w-4xl">

            {# Sur-titre #}
            <div class="flex items-center gap-4 mb-7">

                <span class="w-8 h-[2px] bg-[#C9653B]"></span>

                <span class="text-[11px]
                             uppercase
                             tracking-[0.22em]
                             font-semibold
                             text-[#C9653B]">
                    Le journal de Studio Tempo
                </span>

            </div>


            {# Titre #}
            <h1 class="font-display
                       text-4xl sm:text-5xl lg:text-[3.7rem]
                       leading-[1.04]
                       tracking-[-0.035em]
                       max-w-3xl">

                Référencement naturel
                <span class="text-[#00687A]">&amp;</span>

                <span class="block text-[#C9653B]">
                    développement web
                </span>

            </h1>


            {# Intro #}
            <div class="mt-8
                        grid md:grid-cols-[1fr_.8fr]
                        gap-8 md:gap-14
                        items-end">

                <p class="text-base sm:text-lg
                          leading-8
                          text-ink-soft
                          max-w-2xl">

                    Conseils, réflexions et retours d'expérience
                    autour de WordPress, Symfony, du référencement naturel
                    et de la création de sites web.

                </p>


                {# Petit motif "tempo" discret #}
                <div class="hidden md:flex
                            items-center justify-end
                            gap-2
                            pb-2"
                     aria-hidden="true">

                    <span class="w-8 h-px bg-[#C9653B]/60"></span>

                    <span class="w-2 h-2 rounded-full bg-[#C9653B]"></span>

                    <span class="w-16 h-px bg-[#00687A]/30"></span>

                    <span class="w-2 h-2 rounded-full bg-[#00687A]"></span>

                    <span class="w-6 h-px bg-[#C9653B]/40"></span>

                </div>

            </div>

        </div>


        {# Grande ligne basse #}
        <div class="mt-14
                    h-px
                    bg-gradient-to-r
                    from-[#C9653B]/45
                    via-[#00687A]/15
                    to-transparent">
        </div>

    </section>



    {# =========================================================
       ARTICLES
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12
                    pb-24 lg:pb-32">


        <div class="grid
                    sm:grid-cols-2
                    lg:grid-cols-3
                    gap-x-7 lg:gap-x-8
                    gap-y-14 lg:gap-y-16">


            {% for article in articles %}

                <article class="group relative">


                    <a href="{{ path('app_article_show', {slug: article.slug}) }}"
                       class="block">


                        {# =========================
                           IMAGE
                        ========================= #}

                        <div class="relative
                                    aspect-[4/3]
                                    overflow-hidden
                                    rounded-[1.4rem]
                                    bg-[#E5DACB]">


                            {% if article.image %}

                                <img
                                    src="{{ asset('images/' ~ article.image) }}"
                                    alt="{{ article.titre }}"
                                    class="w-full h-full
                                           object-cover
                                           transition-transform
                                           duration-700
                                           ease-out
                                           group-hover:scale-[1.035]"
                                >

                            {% endif %}


                            {# Numéro éditorial #}
                            <div class="absolute
                                        top-4 left-4
                                        min-w-10 h-10
                                        px-3
                                        rounded-full
                                        bg-[#F7F3EC]/95
                                        backdrop-blur-sm
                                        flex items-center justify-center
                                        shadow-sm">

                                <span class="font-display
                                             text-sm
                                             text-[#00687A]">

                                    {{ '%02d'|format(loop.index) }}

                                </span>

                            </div>


                            {# Accent graphique discret #}
                            <div class="absolute
                                        right-[-35px]
                                        bottom-[-55px]
                                        w-32 h-32
                                        rounded-full
                                        border-[18px]
                                        {% if loop.index is even %}
                                            border-[#00687A]/10
                                        {% else %}
                                            border-[#C9653B]/10
                                        {% endif %}
                                        transition-transform
                                        duration-700
                                        group-hover:-translate-x-2
                                        group-hover:-translate-y-2"
                                 aria-hidden="true">
                            </div>

                        </div>



                        {# =========================
                           CONTENU
                        ========================= #}

                        <div class="pt-5">


                            {# Date + ligne #}
                            <div class="flex items-center gap-3 mb-3">

                                <time datetime="{{ article.publishedAt|date('Y-m-d') }}"
                                      class="text-[10px]
                                             uppercase
                                             tracking-[0.18em]
                                             font-semibold
                                             text-[#C9653B]">

                                    {{ article.publishedAt|date('d M') }}

                                </time>

                                <span class="h-px
                                             w-8
                                             bg-[#C9653B]/40
                                             transition-all
                                             duration-300
                                             group-hover:w-14">
                                </span>

                            </div>


                            {# Titre #}
                            <h2 class="font-display
                                       text-[1.35rem]
                                       leading-[1.25]
                                       transition-colors
                                       duration-300
                                       group-hover:text-[#00687A]">

                                {{ article.titre }}

                            </h2>


                            {# Extrait #}
                            {% if article.extrait %}

                                <p class="mt-3
                                          text-sm
                                          text-ink-soft
                                          leading-6
                                          line-clamp-2">

                                    {{ article.extrait }}

                                </p>

                            {% endif %}


                            {# Lire l'article #}
                            <div class="mt-5
                                        inline-flex
                                        items-center
                                        gap-2
                                        text-xs
                                        font-semibold
                                        text-[#00687A]">

                                <span>Lire l'article</span>

                                <span class="transition-transform
                                             duration-300
                                             group-hover:translate-x-1">
                                    →
                                </span>

                            </div>

                        </div>

                    </a>

                </article>


            {% else %}

                <div class="col-span-full
                            rounded-[1.5rem]
                            border border-[#00687A]/10
                            bg-[#EFE7DA]
                            px-8 py-14
                            text-center">

                    <p class="font-display
                              text-xl
                              text-[#00687A]">
                        Le journal prend bientôt son rythme.
                    </p>

                    <p class="mt-2 text-sm text-ink-soft">
                        Aucun article publié pour le moment.
                    </p>

                </div>

            {% endfor %}


        </div>

    </section>


</div>

{% endblock %}