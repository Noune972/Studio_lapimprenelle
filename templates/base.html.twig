{# Ombre de l'en-tête au défilement + page active dans les menus #}
<script>
(function () {
    function updateHeader() {
        var h = document.querySelector('.tempo-header');
        if (h) h.classList.toggle('is-scrolled', (window.pageYOffset || document.documentElement.scrollTop || 0) > 10);
    }

    function markCurrent() {
        var path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll('.tempo-nav a, .tempo-mobile-nav a').forEach(function (a) {
            if (a.hasAttribute('data-nav-cta')) return;
            var href = new URL(a.href, location.origin).pathname.replace(/\/$/, '') || '/';
            var on = href === '/' ? path === '/' : (path === href || path.indexOf(href + '/') === 0);
            if (on) a.setAttribute('aria-current', 'page');
            else a.removeAttribute('aria-current');
        });
    }

    if (!window.__tempoHeaderInit) {
        window.__tempoHeaderInit = true;
        window.addEventListener('scroll', updateHeader, { passive: true });
    }

    document.addEventListener('turbo:load', function () { updateHeader(); markCurrent(); });
    updateHeader();
    markCurrent();
})();
</script>



