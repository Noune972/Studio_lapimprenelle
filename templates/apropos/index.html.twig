                            bg-[#D9C8A9]/50
                            pointer-events-none">
                </div>


                {# Décoration bas gauche #}

                <div class="absolute
                            -bottom-6 -left-6
                            w-16 h-16
                            rounded-full
                            border border-terracotta/30
                            pointer-events-none">
