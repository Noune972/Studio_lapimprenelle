                            pointer-events-none
                            z-20">
                </div>



                {# =================================================
                   PHOTO
                ================================================= #}

                <div class="relative
                            aspect-[4/5]
                            rounded-[2rem]
                            overflow-hidden
                            bg-[#D9C8A9]
                            shadow-lg
                            group">

                    <img
                        src="{{ asset('images/nath.png') }}"
