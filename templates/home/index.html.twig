<style>
    /* Signature graphique Tempo — cadence / mouvement */
    .tempo-rhythm { display:flex; align-items:flex-end; gap:5px; height:34px; }
    .tempo-rhythm > span { display:block; width:7px; border-radius:999px; background:currentColor; transition:height .35s ease, transform .35s ease, opacity .35s ease; }
    .tempo-rhythm > span:nth-child(1){height:14px}.tempo-rhythm > span:nth-child(2){height:28px}.tempo-rhythm > span:nth-child(3){height:20px}.tempo-rhythm > span:nth-child(4){height:34px}
    .tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(1){height:25px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(2){height:16px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(3){height:32px}.tempo-rhythm-hover:hover .tempo-rhythm > span:nth-child(4){height:22px}
    .tempo-beat { display:flex; align-items:center; gap:10px; color:rgba(196,91,54,.5); }
    .tempo-beat i { display:block; height:1px; border-radius:999px; background:currentColor; }
    @media (prefers-reduced-motion: reduce) { .tempo-rhythm > span { transition:none; } }
</style>

