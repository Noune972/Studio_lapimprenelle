{% extends 'base.html.twig' %}

{% block title %}Politique de confidentialité — Tempo{% endblock %}

{% block meta_description %}
    Politique de confidentialité et protection des données personnelles du site Tempo.
{% endblock %}

{% block body %}

<section class="bg-white">

    <div class="max-w-5xl mx-auto px-6 sm:px-10 py-16 lg:py-24">

        {# EN-TÊTE #}
        <header class="mb-14 lg:mb-16">

            <p class="mb-4
                      text-xs
                      uppercase
                      tracking-[0.18em]
                      text-ink-soft">
                Protection des données
            </p>

            <h1 class="font-display
                       text-4xl sm:text-5xl
                       text-ink
                       leading-tight">
                Politique de confidentialité
            </h1>

            <p class="mt-5
                      max-w-2xl
                      text-sm
                      leading-7
                      text-ink-soft">
                Tempo accorde une attention particulière à la protection
                de vos données personnelles et à leur utilisation dans
                le respect de la réglementation applicable.
            </p>

        </header>


        <div class="border-t border-[#D9C8A9]">


            {# RESPONSABLE DU TRAITEMENT #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Responsable du traitement
                </h2>

                <div class="text-sm leading-7 text-ink-soft">

                    <p class="font-semibold text-ink">
                        Tempo — Nathalie Camiul
                    </p>

                    <p>Entrepreneur individuel</p>
                    <p>Toulouse, France</p>

                    <p>
                        E-mail :
                        <a href="mailto:contact@tempo-agenceweb.com"
                           class="text-ink underline underline-offset-4">
                            contact@tempo-agenceweb.com
                        </a>
                    </p>

                </div>

            </section>


            {# DONNÉES COLLECTÉES #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Données collectées
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Lorsque vous utilisez le formulaire de contact,
                        Tempo collecte uniquement les informations que vous
                        renseignez volontairement afin de pouvoir traiter
                        votre demande.
                    </p>

                    <p>
                        Il peut notamment s'agir de vos coordonnées,
                        des informations relatives à votre projet,
                        de votre budget estimé ainsi que du contenu
                        de votre message.
                    </p>

                    <p>
                        Aucune donnée sensible n'est demandée par
                        l'intermédiaire du formulaire de contact.
                    </p>

                </div>

            </section>


            {# FINALITÉ #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Pourquoi ces données ?
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Les données transmises sont utilisées afin de
                        répondre à votre demande, échanger avec vous
                        au sujet de votre projet et, le cas échéant,
                        préparer une proposition commerciale ou un devis.
                    </p>

                    <p>
                        Elles ne sont pas utilisées pour l'envoi d'une
                        newsletter ou pour des opérations de prospection
                        automatisée.
                    </p>

                </div>

            </section>


            {# BASE LÉGALE #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Base légale
                </h2>

                <div class="text-sm leading-7 text-ink-soft">

                    <p>
                        Lorsque votre demande concerne un projet,
                        une prestation ou une demande de devis,
                        le traitement est nécessaire à la mise en œuvre
                        de mesures précontractuelles prises à votre demande.
                    </p>

                </div>

            </section>


            {# DESTINATAIRES #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Destinataires
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Les données transmises par le formulaire sont
                        destinées à Nathalie Camiul, responsable de Tempo,
                        afin de traiter votre demande.
                    </p>

                    <p>
                        Les prestataires techniques nécessaires au
                        fonctionnement du site et de la messagerie peuvent
                        également traiter certaines données dans le cadre
                        strict de leurs prestations.
                    </p>

                    <p>
                        Tempo ne vend ni ne loue vos données personnelles
                        à des tiers.
                    </p>

                </div>

            </section>


            {# HÉBERGEMENT #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Hébergement
                </h2>

                <div class="text-sm leading-7 text-ink-soft">

                    <p>
                        Le site est hébergé par Hostinger International Limited,
                        61 Lordou Vironos str., 6023 Larnaca, Chypre.
                    </p>

                </div>

            </section>


            {# CONSERVATION #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Durée de conservation
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Les données relatives à une demande de contact
                        ou de devis qui ne donne pas lieu à une relation
                        commerciale sont conservées pendant une durée
                        maximale d'un an à compter du dernier échange.
                    </p>

                    <p>
                        Lorsqu'une relation contractuelle est engagée,
                        certaines informations peuvent être conservées
                        pendant les durées nécessaires à la gestion de
                        la relation commerciale et au respect des
                        obligations légales applicables.
                    </p>

                </div>

            </section>


            {# COOKIES #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Cookies et mesure d'audience
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Tempo n'utilise actuellement aucun outil de mesure
                        d'audience, de suivi publicitaire ou de profilage
                        des visiteurs.
                    </p>

                    <p>
                        Le site n'utilise pas de cookies à des fins
                        publicitaires ou de suivi des utilisateurs.
                    </p>

                </div>

            </section>


            {# DROITS #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9
                            border-b border-[#D9C8A9]">

                <h2 class="text-sm font-semibold text-ink">
                    Vos droits
                </h2>

                <div class="space-y-4 text-sm leading-7 text-ink-soft">

                    <p>
                        Conformément à la réglementation applicable en
                        matière de protection des données personnelles,
                        vous pouvez notamment demander l'accès aux données
                        vous concernant, leur rectification, leur effacement
                        ou la limitation de leur traitement lorsque ces
                        droits sont applicables.
                    </p>

                    <p>
                        Pour exercer vos droits ou poser une question
                        concernant vos données personnelles, vous pouvez
                        écrire à :
                    </p>

                    <p>
                        <a href="mailto:contact@tempo-agenceweb.com"
                           class="font-semibold text-ink
                                  underline underline-offset-4">
                            contact@tempo-agenceweb.com
                        </a>
                    </p>

                </div>

            </section>


            {# CNIL #}
            <section class="grid md:grid-cols-[220px_1fr]
                            gap-4 md:gap-12
                            py-9">

                <h2 class="text-sm font-semibold text-ink">
                    Réclamation
                </h2>

                <div class="text-sm leading-7 text-ink-soft">

                    <p>
                        Si vous estimez, après avoir contacté Tempo,
                        que vos droits relatifs à vos données personnelles
                        ne sont pas respectés, vous pouvez introduire
                        une réclamation auprès de la Commission nationale
                        de l'informatique et des libertés (CNIL).
                    </p>

                </div>

            </section>

        </div>


        <div class="pt-10 mt-4
                    border-t border-[#D9C8A9]
                    text-xs text-ink-soft">

            Dernière mise à jour : septembre 2026.

        </div>

    </div>

</section>

{% endblock %}