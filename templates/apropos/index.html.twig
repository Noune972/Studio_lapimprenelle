                        {# Identité #}

                        <div>

                            <div class="text-[10px]
                                        tracking-[0.22em]
                                        uppercase
                                        text-terracotta
                                        font-semibold
                                        mb-1">
                                Tempo
                            </div>

                            <div class="text-sm
                                        font-semibold
                                        text-ink">
                                 Agence web
                            </div>

                        </div>



                        {# =================================================
                           RÉSEAUX SOCIAUX
                        ================================================= #}

                        <div class="flex items-center gap-2">


                            {# =============================
                               LINKEDIN
                            ============================= #}

                            <a
                                href="https://fr.linkedin.com/in/nathalie-camiul-847620198"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Retrouvez Tempo sur LinkedIn"

                                class="flex
                                       items-center
                                       justify-center
                                       w-9 h-9
                                       flex-shrink-0
                                       rounded-full
                                       bg-[#00687A]
                                       text-white
                                       transition-all
                                       duration-300
                                       
                                       hover:-translate-y-0.5
                                       hover:shadow-md"
                            >

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    class="w-4 h-4"
                                    aria-hidden="true"
