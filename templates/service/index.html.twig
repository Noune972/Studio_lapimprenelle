{% extends 'base.html.twig' %}

{% block title %}Services web | Tempo{% endblock %}

{% block body %}

<main class="bg-cream text-ink overflow-hidden">

    {# =========================================================
       HERO
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pt-16 lg:pt-24
                    pb-16 lg:pb-20">

        <div class="relative overflow-hidden
                    bg-[#EFE7DA]
                    rounded-[2.5rem]
                    px-7 py-12
                    sm:px-10 sm:py-14
                    lg:px-14 lg:py-16">

            {# Décoration #}
            <div class="absolute -top-24 -right-20
                        w-64 h-64 rounded-full
                        bg-[#00687A]/5">
            </div>

            <div class="absolute -bottom-16 right-32
                        w-32 h-32 rounded-full
                        border border-terracotta/15">
            </div>

            <div class="relative max-w-4xl reveal">

                <div class="flex items-center gap-4 mb-7">
                    <span class="w-10 h-px bg-terracotta"></span>

                    <span class="text-xs tracking-[0.25em]
                                 uppercase font-semibold
                                 text-terracotta">
                        Mes services
                    </span>
                </div>

                <h1 class="font-display
                           text-4xl sm:text-5xl lg:text-[3.6rem]
                           leading-[1.08] tracking-tight">

                    Des solutions web pensées<br class="hidden sm:block">
                    pour accompagner

                    <span class="text-terracotta">
                        vos ambitions.
                    </span>

                </h1>

                <p class="mt-8 max-w-2xl
                          text-lg sm:text-xl
                          leading-relaxed text-ink-soft">

                    Site WordPress, e-commerce ou application Symfony :
                    je conçois des solutions digitales élégantes,
                    performantes et pensées pour durer.

                </p>

            </div>

        </div>

    </section>


    {# =========================================================
       INTRO
    ========================================================= #}

    <section class="max-w-6xl mx-auto
                    px-6 sm:px-8 lg:px-12 xl:px-16
                    pb-20 lg:pb-24">

        <div class="grid lg:grid-cols-[0.7fr_1.3fr]
                    gap-8 lg:gap-16
                    items-start">

            <div class="pt-2">

                <span class="text-xs tracking-[0.22em]
                             uppercase font-semibold
                             text-terracotta">
                    Une approche complète
                </span>

            </div>


            <div class="max-w-2xl">

                <p class="font-display
                          text-2xl sm:text-[1.8rem]
                          leading-[1.45]">

                    Un beau site ne suffit pas. Il doit être
                    <span class="text-[#00687A]">utile</span>,
                    rapide, accessible et capable d'être trouvé
                    par les bonnes personnes.

                </p>

                <p class="mt-6 text-base sm:text-lg
                          leading-8 text-ink-soft">

                    C'est pourquoi conception, développement,
                    expérience utilisateur, performance et référencement
                    naturel sont pensés ensemble dès le début du projet.

                </p>

            </div>

        </div>

    </section>
{# =========================================================
   EXPERTISES
========================================================= #}

<section class="max-w-6xl mx-auto
                px-6 sm:px-8 lg:px-12 xl:px-16
                pb-20 lg:pb-28">

    <div class="flex items-center gap-4 mb-8">

        <span class="w-10 h-px bg-terracotta"></span>

        <span class="text-xs tracking-[0.22em]
                     uppercase font-semibold
                     text-terracotta">
            Mes expertises
        </span>

    </div>


    <div class="space-y-4">


        {# =====================================================
           WORDPRESS
        ===================================================== #}

        <article class="grid
                        lg:grid-cols-[50px_0.7fr_1.3fr]
                        gap-5 lg:gap-9
                        items-start
                        bg-[#F6F2EB]
                        border border-[#D9C8A9]/25
                        rounded-2xl
                        px-6 sm:px-7 lg:px-8
                        py-6 lg:py-7
                        reveal">

            {# Numéro #}

            <div>

                <span class="font-display
                             text-2xl
                             leading-none
                             text-terracotta/45">
                    01
                </span>

            </div>


            {# Titre #}

            <div>

                <span class="block mb-2
                             text-xs tracking-[0.18em]
                             uppercase font-semibold
                             text-terracotta">
                    WordPress
                </span>

                <h2 class="font-display
                           text-2xl sm:text-3xl
                           leading-[1.15]">

                    Votre site,
                    <span class="text-terracotta">
                        à votre image.
                    </span>

                </h2>

            </div>


            {# Description #}

            <div class="max-w-xl">

                <p class="text-base
                          leading-7
                          text-ink-soft">

                    Je crée des sites WordPress sur mesure,
                    esthétiques, responsive et performants,
                    pensés pour présenter votre activité avec clarté
                    tout en restant simples à administrer.

                </p>


                <div class="flex flex-wrap
                            gap-x-5 gap-y-2
                            mt-4">

                    {% for item in [
                        'One page',
                        'Site vitrine',
                        'E-commerce',
                        'Refonte'
                    ] %}

                        <span class="inline-flex
                                     items-center gap-2
                                     text-sm font-medium
                                     text-ink-soft">

                            <span class="w-1.5 h-1.5
                                         rounded-full
                                         bg-terracotta">
                            </span>

                            {{ item }}

                        </span>

                    {% endfor %}

                </div>

            </div>

        </article>



        {# =====================================================
           SYMFONY
        ===================================================== #}

        <article class="grid
                        lg:grid-cols-[50px_0.7fr_1.3fr]
                        gap-5 lg:gap-9
                        items-start
                        bg-[#F6F2EB]
                        border border-[#D9C8A9]/25
                        rounded-2xl
                        px-6 sm:px-7 lg:px-8
                        py-6 lg:py-7
                        reveal">

            {# Numéro #}

            <div>

                <span class="font-display
                             text-2xl
                             leading-none
                             text-terracotta/45">
                    02
                </span>

            </div>


            {# Titre #}

            <div>

                <span class="block mb-2
                             text-xs tracking-[0.18em]
                             uppercase font-semibold
                             text-terracotta">
                    Symfony
                </span>

                <h2 class="font-display
                           text-2xl sm:text-3xl
                           leading-[1.15]">

                    Pour les projets
                    <span class="text-terracotta">
                        qui vont plus loin.
                    </span>

                </h2>

            </div>


            {# Description #}

            <div class="max-w-xl">

                <p class="text-base
                          leading-7
                          text-ink-soft">

                    Je développe des applications Symfony sur mesure
                    lorsque votre projet nécessite des fonctionnalités
                    spécifiques, des données métier, des espaces utilisateurs
                    ou une logique plus avancée.

                </p>


                <div class="flex flex-wrap
                            gap-x-5 gap-y-2
                            mt-4">

                    {% for item in [
                        'Application web',
                        'Interface mobile',
                        'Outil métier',
                        'Back-office'
                    ] %}

                        <span class="inline-flex
                                     items-center gap-2
                                     text-sm font-medium
                                     text-ink-soft">

                            <span class="w-1.5 h-1.5
                                         rounded-full
                                         bg-[#00687A]">
                            </span>

                            {{ item }}

                        </span>

                    {% endfor %}

                </div>

            </div>

        </article>



        {# =====================================================
           SEO
        ===================================================== #}

        <article class="grid
                        lg:grid-cols-[50px_0.7fr_1.3fr]
                        gap-5 lg:gap-9
                        items-start
                        bg-[#F6F2EB]
                        border border-[#D9C8A9]/25
                        rounded-2xl
                        px-6 sm:px-7 lg:px-8
                        py-6 lg:py-7
                        reveal">

            {# Numéro #}

            <div>

                <span class="font-display
                             text-2xl
                             leading-none
                             text-terracotta/45">
                    03
                </span>

            </div>


            {# Titre #}

            <div>

                <span class="block mb-2
                             text-xs tracking-[0.18em]
                             uppercase font-semibold
                             text-terracotta">
                    Référencement SEO
                </span>

                <h2 class="font-display
                           text-2xl sm:text-3xl
                           leading-[1.15]">

                    Être visible
                    <span class="text-terracotta">
                        naturellement.
                    </span>

                </h2>

            </div>


            {# Description #}

            <div class="max-w-xl">

                <p class="text-base
                          leading-7
                          text-ink-soft">

                    Le socle SEO est intégré dès la conception :
                    structure des pages, balisage, contenus,
                    performances et bonnes pratiques techniques
                    sont pensés pour faciliter votre visibilité.

                </p>


                <div class="inline-flex
                            items-center gap-2.5
                            mt-4
                            text-sm font-medium
                            text-[#00687A]">

                    <span class="flex
                                 w-5 h-5
                                 shrink-0
                                 items-center justify-center
                                 rounded-full
                                 bg-[#00687A]
                                 text-white
                                 text-[10px]">
                        ✓
                    </span>

                    Socle SEO inclus dans les prestations

                </div>

            </div>

        </article>

    </div>

</section>



    {# =========================================================
   TYPES DE PROJETS / OFFRES
========================================================= #}

<section class="max-w-6xl mx-auto
                px-6 sm:px-8 lg:px-12 xl:px-16
                pb-20 lg:pb-28">

    <div class="relative
                bg-[#00687A]
                text-white
                rounded-[2.5rem]
                overflow-hidden
                px-7 sm:px-10 lg:px-14
                py-14 lg:py-16">


        {# Décoration #}

        <div class="absolute
                    -right-24 -top-24
                    w-72 h-72
                    rounded-full
                    border border-white/10">
        </div>

        <div class="absolute
                    right-20 -bottom-20
                    w-40 h-40
                    rounded-full
                    bg-white/[0.03]">
        </div>


        <div class="relative">


            {# =================================================
               INTRO
            ================================================= #}

            <div class="grid
                        lg:grid-cols-[0.65fr_1.35fr]
                        gap-8 lg:gap-16
                        mb-12 lg:mb-14">

                <div>

                    <span class="text-xs
                                 tracking-[0.22em]
                                 uppercase font-semibold
                                 text-[#F1A579]">
                        Votre projet
                    </span>

                </div>


                <div class="max-w-2xl">

                    <h2 class="font-display
                               text-3xl sm:text-4xl
                               leading-[1.18]">

                        Une solution adaptée à ce que
                        <span class="text-[#F1A579]">
                            vous voulez construire.
                        </span>

                    </h2>

                    <p class="mt-5
                              text-base sm:text-lg
                              leading-8
                              text-white/70">

                        Du site one page à l'application métier,
                        chaque projet est conçu sur mesure avec une attention
                        particulière portée à l'expérience utilisateur,
                        aux performances et à la qualité technique.

                    </p>

                </div>

            </div>



            {# =================================================
               ONE PAGE
            ================================================= #}

            <article class="grid
                            lg:grid-cols-[0.7fr_1.3fr]
                            gap-8 lg:gap-14
                            rounded-[2rem]
                            bg-white/[0.07]
                            border border-white/10
                            p-7 sm:p-8 lg:p-10
                            reveal">

                {# Présentation #}

                <div>

                    <div class="flex items-center gap-4">

                        <span class="font-display
                                     text-xl
                                     text-[#F1A579]">
                            01
                        </span>

                        <span class="text-xs
                                     tracking-[0.18em]
                                     uppercase
                                     text-white/50">
                            Site One Page
                        </span>

                    </div>


                    <h3 class="font-display
                               text-2xl sm:text-3xl
                               leading-[1.2]
                               mt-7">

                        Une présence claire,
                        <span class="block text-[#F1A579]">
                            simple et efficace.
                        </span>

                    </h3>


                    <p class="mt-5
                              text-sm sm:text-base
                              leading-7
                              text-white/70">

                        Idéal pour présenter une activité, une offre
                        ou un lancement avec un parcours fluide
                        concentré sur une seule page.

                    </p>


                    {# Délai #}

                    <div class="mt-8
                                inline-flex
                                items-center gap-3
                                rounded-full
                                bg-white/[0.08]
                                border border-white/10
                                px-4 py-2.5">

                        <svg class="w-4 h-4 text-[#F1A579]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 7v5l3 2"/>

                        </svg>

                        <span class="text-xs text-white/60">
                            Délai estimé
                        </span>

                        <span class="text-sm font-semibold">
                            1 semaine
                        </span>

                    </div>

                </div>


                {# Inclus #}

                <div class="lg:border-l
                            lg:border-white/10
                            lg:pl-12">

                    <p class="text-xs
                              tracking-[0.18em]
                              uppercase font-semibold
                              text-white/50
                              mb-6">
                        Ce qui est inclus
                    </p>


                    {% set onePageFeatures = [
                        'Conception d’une page unique intuitive et esthétique',
                        'Contenu organisé pour une narration claire et captivante',
                        'Intégration de fonctionnalités interactives',
                        'Optimisation du référencement naturel (SEO)',
                        'Optimisation du temps de chargement',
                        'Compatibilité mobile, tablette et desktop',
                        'Mise en place du certificat SSL'
                    ] %}


                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">

                        {% for feature in onePageFeatures %}

                            <div class="flex items-start gap-3">

                                <span class="mt-0.5
                                             flex w-5 h-5
                                             shrink-0
                                             items-center justify-center
                                             rounded-full
                                             bg-[#F1A579]/15">

                                    <svg class="w-3 h-3
                                                text-[#F1A579]"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M5 12.5l4 4L19 7"/>

                                    </svg>

                                </span>

                                <p class="text-sm
                                          leading-6
                                          text-white/70">
                                    {{ feature }}
                                </p>

                            </div>

                        {% endfor %}

                    </div>

                </div>

            </article>



            {# =================================================
               SITE VITRINE
            ================================================= #}

            <article class="grid
                            lg:grid-cols-[0.7fr_1.3fr]
                            gap-8 lg:gap-14
                            rounded-[2rem]
                            bg-white/[0.07]
                            border border-white/10
                            p-7 sm:p-8 lg:p-10
                            mt-5
                            reveal">

                <div>

                    <div class="flex items-center gap-4">

                        <span class="font-display
                                     text-xl
                                     text-[#F1A579]">
                            02
                        </span>

                        <span class="text-xs
                                     tracking-[0.18em]
                                     uppercase
                                     text-white/50">
                            Site vitrine
                        </span>

                    </div>


                    <h3 class="font-display
                               text-2xl sm:text-3xl
                               leading-[1.2]
                               mt-7">

                        Une vitrine digitale
                        <span class="block text-[#F1A579]">
                            à votre image.
                        </span>

                    </h3>


                    <p class="mt-5
                              text-sm sm:text-base
                              leading-7
                              text-white/70">

                        Un site complet pour présenter votre entreprise,
                        valoriser vos services et transformer vos visiteurs
                        en prises de contact.

                    </p>


                    <div class="mt-8
                                inline-flex
                                items-center gap-3
                                rounded-full
                                bg-white/[0.08]
                                border border-white/10
                                px-4 py-2.5">

                        <svg class="w-4 h-4 text-[#F1A579]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 7v5l3 2"/>
                        </svg>

                        <span class="text-xs text-white/60">
                            Délai estimé
                        </span>

                        <span class="text-sm font-semibold">
                            3 semaines
                        </span>

                    </div>

                </div>


                <div class="lg:border-l
                            lg:border-white/10
                            lg:pl-12">

                    <p class="text-xs
                              tracking-[0.18em]
                              uppercase font-semibold
                              text-white/50
                              mb-6">
                        Ce qui est inclus
                    </p>


                    {% set vitrineFeatures = [
                        'Conception d’un site multipage adapté à votre activité',
                        'Organisation des contenus et de la navigation',
                        'Design personnalisé dans le respect de votre identité visuelle',
                        'Responsive mobile, tablette et desktop',
                        'Formulaire de contact et fonctionnalités adaptées',
                        'Optimisation SEO technique des pages',
                        'Optimisation des performances et du temps de chargement',
                        'Mise en place du certificat SSL'
                    ] %}


                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">

                        {% for feature in vitrineFeatures %}

                            <div class="flex items-start gap-3">

                                <span class="mt-0.5
                                             flex w-5 h-5
                                             shrink-0
                                             items-center justify-center
                                             rounded-full
                                             bg-[#F1A579]/15">

                                    <svg class="w-3 h-3
                                                text-[#F1A579]"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M5 12.5l4 4L19 7"/>

                                    </svg>

                                </span>

                                <p class="text-sm
                                          leading-6
                                          text-white/70">
                                    {{ feature }}
                                </p>

                            </div>

                        {% endfor %}

                    </div>

                </div>

            </article>



            {# =================================================
               E-COMMERCE
            ================================================= #}

            <article class="grid
                            lg:grid-cols-[0.7fr_1.3fr]
                            gap-8 lg:gap-14
                            rounded-[2rem]
                            bg-white/[0.07]
                            border border-white/10
                            p-7 sm:p-8 lg:p-10
                            mt-5
                            reveal">

                <div>

                    <div class="flex items-center gap-4">

                        <span class="font-display
                                     text-xl
                                     text-[#F1A579]">
                            03
                        </span>

                        <span class="text-xs
                                     tracking-[0.18em]
                                     uppercase
                                     text-white/50">
                            E-commerce
                        </span>

                    </div>


                    <h3 class="font-display
                               text-2xl sm:text-3xl
                               leading-[1.2]
                               mt-7">

                        Une boutique pensée
                        <span class="block text-[#F1A579]">
                            pour vos clients.
                        </span>

                    </h3>


                    <p class="mt-5
                              text-sm sm:text-base
                              leading-7
                              text-white/70">

                        Une boutique en ligne claire et rassurante,
                        pensée pour valoriser vos produits et simplifier
                        le parcours d'achat.

                    </p>


                    <div class="mt-8
                                inline-flex
                                items-center gap-3
                                rounded-full
                                bg-white/[0.08]
                                border border-white/10
                                px-4 py-2.5">

                        <svg class="w-4 h-4 text-[#F1A579]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 7v5l3 2"/>
                        </svg>

                        <span class="text-xs text-white/60">
                            Délai estimé
                        </span>

                        <span class="text-sm font-semibold">
                            1 mois et demi
                        </span>

                    </div>

                </div>


                <div class="lg:border-l
                            lg:border-white/10
                            lg:pl-12">

                    <p class="text-xs
                              tracking-[0.18em]
                              uppercase font-semibold
                              text-white/50
                              mb-6">
                        Ce qui est inclus
                    </p>


                    {% set ecommerceFeatures = [
                        'Conception graphique adaptée à votre identité',
                        'Création et organisation du catalogue produits',
                        'Pages produits et catégories',
                        'Panier et parcours de commande',
                        'Intégration du paiement sécurisé',
                        'Gestion des commandes et de la boutique',
                        'Responsive mobile, tablette et desktop',
                        'Optimisation SEO technique',
                        'Optimisation des performances',
                        'Mise en place du certificat SSL'
                    ] %}


                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4">

                        {% for feature in ecommerceFeatures %}

                            <div class="flex items-start gap-3">

                                <span class="mt-0.5
                                             flex w-5 h-5
                                             shrink-0
                                             items-center justify-center
                                             rounded-full
                                             bg-[#F1A579]/15">

                                    <svg class="w-3 h-3
                                                text-[#F1A579]"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M5 12.5l4 4L19 7"/>

                                    </svg>

                                </span>

                                <p class="text-sm
                                          leading-6
                                          text-white/70">
                                    {{ feature }}
                                </p>

                            </div>

                        {% endfor %}

                    </div>

                </div>

            </article>



            {# =================================================
               APPLICATION SYMFONY
            ================================================= #}

            <article class="grid
                            lg:grid-cols-[0.7fr_1.3fr]
                            gap-8 lg:gap-14
                            rounded-[2rem]
                            bg-[#F7F1E7]
                            text-ink
                            border border-white/10
                            p-7 sm:p-8 lg:p-10
                            mt-5
                            reveal">

                <div>

                    <div class="flex items-center gap-4">

                        <span class="font-display
                                     text-xl
                                     text-terracotta">
                            04
                        </span>

                        <span class="text-xs
                                     tracking-[0.18em]
                                     uppercase
                                     text-ink-soft">
                            Application Symfony
                        </span>

                    </div>


                    <h3 class="font-display
                               text-2xl sm:text-3xl
                               leading-[1.2]
                               mt-7">

                        Une solution conçue
                        <span class="block text-terracotta">
