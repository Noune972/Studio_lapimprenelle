                                px-4 py-2.5">

                        <svg class="w-4 h-4 text-[#00687A]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 7v5l3 2"/>
                        </svg>

                        <span class="text-xs text-ink-soft">
                            Délai estimé
                        </span>

                        <span class="text-sm
                                     font-semibold
                                     text-[#00687A]">
                            2 à 3 mois
                        </span>

                    </div>

                </div>


