{% extends 'base.html.twig' %}
{% block title %}Blog — Studio Lapimprenelle{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-10">
    <h1 class="text-xl font-medium text-center mb-8">Articles et conseils</h1>
    <div class="flex flex-col gap-3">
        {% for article in articles %}
        <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="flex gap-4 items-center p-3 bg-gray-50 rounded-xl">
            <div class="w-14 h-14 bg-gray-100 rounded-lg flex-shrink-0"></div>
            <div>
                <div class="text-sm font-medium">{{ article.titre }}</div>
                <div class="text-xs text-gray-400">{{ article.publishedAt|date('d F Y') }}</div>
            </div>
        </a>
        {% else %}
        <p class="text-sm text-gray-500 text-center">Aucun article publié pour le moment.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
