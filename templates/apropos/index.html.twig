{% extends 'base.html.twig' %}

{% block title %}À propos de Tempo agence web à Toulouse{% endblock %}

{% block meta_description %}
    Découvrez Tempo, agence web à Toulouse spécialisée dans la création de sites WordPress, le développement Symfony et le référencement naturel.
{% endblock %}

{% block body %}

<div class="bg-cream text-ink overflow-hidden">

    {# =========================================================
       HERO
    ========================================================= #}

    <section class="max-w-6xl mx-auto
