    <meta property="og:image"
          content="{{ absolute_url(asset('images/tempo7.png')) }}">

    <meta property="og:locale"
          content="fr_FR">

    <meta property="og:site_name"
          content="Studio Tempo">


    <link rel="icon"
      type="image/png"
      href="{{ asset('images/favicon2.png') }}?v=2">

    <meta name="viewport" content="width=device-width, initial-scale=1">
    
{% block stylesheets %}
{% endblock %}

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@800&display=swap" rel="stylesheet">

</head>


{# overflow-x-hidden retiré de <html> et <body> : il empêchait l'en-tête fixe de fonctionner.
   Il est remplacé par overflow-x: clip dans le <style> de l'en-tête. #}
<body class="bg-cream text-ink font-sans min-h-screen flex flex-col">


{# =========================================================
   STYLE DE L'EN-TÊTE
========================================================= #}
<style>
    /* Coupe ce qui dépasse sur les côtés sans casser position: sticky.
       La 1re ligne sert de secours aux navigateurs qui ne connaissent pas "clip". */
    html, body { overflow-x: hidden; overflow-x: clip; }

    /* ---------- En-tête fixe ---------- */
    .tempo-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: #F7F3EC;   /* opaque : le texte de la page ne transparaît plus dessous */
        border-bottom: 1px solid transparent;
        transition: box-shadow .3s ease, border-color .3s ease;
    }

    .tempo-header.is-scrolled {
        border-bottom-color: #E7DDD2;
        box-shadow: 0 6px 24px rgba(23, 40, 36, .08);
    }

    /* ---------- Logo (une seule règle, valable pour les deux noms de classe) ---------- */
    .tempo-header .tempo-logo,
    .tempo-header .logo-header-tempo {
        display: block;
        width: 80px;          /* mobile */
        height: auto;
        max-width: none;
    }

    @media (min-width: 768px) and (max-width: 1023px) {
        .tempo-header .tempo-logo,
        .tempo-header .logo-header-tempo { width: 100px; }
    }

    @media (min-width: 1024px) {
        .tempo-header .tempo-logo,
        .tempo-header .logo-header-tempo { width: 125px; }
    }

    /* ---------- Mention « Agence web indépendante » (mobile) ---------- */
    .tempo-header-tag {
        flex: 1 1 0;
        min-width: 0;
        padding: 0 8px;
        text-align: center;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.25;
        color: black;
        text-wrap: balance;
    }

    @media (min-width: 768px) { .tempo-header-tag { display: none; } }
    @media (max-width: 339px) { .tempo-header-tag { display: none; } }

    /* ---------- Menu desktop ---------- */
    .tempo-nav { display: none; }

    @media (min-width: 768px) {
        .tempo-nav { display: flex; align-items: center; gap: 2px; }
    }

    .tempo-nav a { white-space: nowrap; }

    .tempo-nav a:not(.tempo-nav-cta) {
        position: relative;
        padding: 10px 8px;
        font-size: 14px;
        font-weight: 500;
        color: #2f3a37;
        text-decoration: none;
        transition: color .2s ease;
    }

    @media (min-width: 1024px) {
        .tempo-nav { gap: 4px; }
        .tempo-nav a:not(.tempo-nav-cta) { padding: 10px 14px; font-size: 15px; }
    }

    /* Trait terracotta qui glisse sous le lien */
    .tempo-nav a:not(.tempo-nav-cta)::after {
        content: "";
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: 3px;
        height: 2px;
        border-radius: 2px;
        background: #C9653B;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .3s ease;
    }

    @media (min-width: 1024px) {
        .tempo-nav a:not(.tempo-nav-cta)::after { left: 14px; right: 14px; }
    }

    .tempo-nav a:not(.tempo-nav-cta):hover,
    .tempo-nav a:not(.tempo-nav-cta):focus-visible,
    .tempo-nav a[aria-current="page"] { color: #00687A; }

    .tempo-nav a:not(.tempo-nav-cta):hover::after,
    .tempo-nav a:not(.tempo-nav-cta):focus-visible::after,
    .tempo-nav a[aria-current="page"]::after { transform: scaleX(1); }

    .tempo-nav a[aria-current="page"] { font-weight: 600; }

    /* Bouton Contact desktop */
    .tempo-nav-cta {
        font-weight: 600;
        transition: transform .25s ease, background-color .25s ease, box-shadow .25s ease;
    }

    .tempo-nav-cta:hover,
    .tempo-nav-cta:focus-visible {
        background-color: #005966;
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0, 104, 122, .28);
    }

    /* ========================================
       MENU MOBILE — FIL CONDUCTEUR
    ======================================== */
    .tempo-mobile-panel {
        position: absolute;
        z-index: 100;
        background-color: #FBF8F3 !important;
        border: 1px solid #E8DCCE;
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(23, 40, 36, .18);
        overflow-x: hidden;
        overflow-y: auto;
        max-height: calc(100dvh - 110px);
        isolation: isolate;
    }

    .tempo-mobile-nav {
        position: relative;
        z-index: 1;
        padding: 26px 24px 24px;
    }

    /* Ligne verticale */
    .tempo-mobile-timeline {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-bottom: 25px;
    }

    .tempo-mobile-timeline::before {
        content: "";
        position: absolute;
        left: 11px;
        top: 25px;
        bottom: 25px;
        width: 1px;
        background: #D9A38C;
    }

    /* Liens */
    .tempo-mobile-link {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 56px;
        padding: 10px 12px 10px 48px;
        color: #173D42;
        font-size: 17px;
        font-weight: 500;
        text-decoration: none;
        border-radius: 14px;
        transition: color .2s ease, background .2s ease;
    }

    /* Petits points sur la ligne */
    .tempo-mobile-link::before {
        content: "";
        position: absolute;
        left: 5px;
        top: 50%;
        transform: translateY(-50%);
        width: 13px;
        height: 13px;
        border-radius: 50%;
        border: 1.5px solid #D18A69;
        background: #FBF8F3;
        z-index: 1;
    }

    .tempo-mobile-link:hover {
        color: #A94F2C;
        background: #F5EBE3;
    }

    /* Page active : fonctionne avec la classe is-active OU avec aria-current (posé par le script) */
    .tempo-mobile-link.is-active,
    .tempo-mobile-link[aria-current="page"] {
        color: #00687A;
        font-weight: 700;
        background: #F3E8DF;
    }

    .tempo-mobile-link.is-active::before,
    .tempo-mobile-link[aria-current="page"]::before {
        background: #C9653B;
        border-color: #C9653B;
        box-shadow: 0 0 0 4px #FBF8F3;
    }

    /* Bouton contact bleu pétrole */
    .tempo-mobile-contact {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 22px;
        border-radius: 16px;
        background: #00687A;
        color: #FFFFFF;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s ease, transform .2s ease;
    }

    .tempo-mobile-contact:hover {
        background: #004E5C;
        color: #FFFFFF;
        transform: translateY(-2px);
    }

    /* Écrans très étroits */
    @media (max-width: 360px) {
        .tempo-mobile-nav { padding: 20px 18px; }
        .tempo-mobile-link { min-height: 50px; }
    }

    /* Frise végétale du menu mobile */
    @media (max-width: 767px) {
        .tempo-mobile-panel::before {
            content: "";
            position: absolute;
            right: 14px;
            top: 105px;
            width: 65px;
            height: 280px;
            border-right: 2px solid #78AEB0;
            border-radius: 50%;
            transform: rotate(8deg);
            pointer-events: none;
            z-index: 0;
        }

        .tempo-mobile-panel::after {
            content: "";
            position: absolute;
            right: -28px;
            top: 165px;
            width: 95px;
            height: 145px;
            background: #00687A;
            opacity: .22;
            border-radius: 90% 0 90% 0;
            transform: rotate(-25deg);
            pointer-events: none;
            z-index: 0;
        }
    }

    /* ---------- Animations réduites ---------- */
    @media (prefers-reduced-motion: reduce) {
        .tempo-header,
        .tempo-nav a,
        .tempo-nav a::after,
        .tempo-nav-cta,
        .tempo-mobile-link,
        .tempo-mobile-contact { transition: none; }
    }
</style>

